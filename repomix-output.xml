                    <div class="modal-footer" style="border-top: 1px solid rgba(0, 242, 255, 0.2);">
                        <button type="button" class="btn btn-cyber btn-cyber-secondary" data-bs-dismiss="modal">Đóng</button>
                        <button type="button" class="btn btn-cyber btn-cyber-info" id="btnConfirmExport" onclick="executeExcelExport()">
                            <i class="fas fa-file-export me-2"></i>Xác Nhận Xuất
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="offcanvas offcanvas-end" tabindex="-1" id="pendingStockOffcanvas" style="background: rgba(10, 15, 20, 0.98); backdrop-filter: blur(20px); border-left: 1px solid #ffaa00; width: 450px;">
            <div class="offcanvas-header" style="border-bottom: 1px solid rgba(255, 170, 0, 0.2);">
                <h5 class="offcanvas-title" style="color: #ffaa00; font-weight: 600;">
                    <i class="fas fa-hourglass-half me-2"></i>Lệnh Xuất Chờ Phê Duyệt
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
            </div>
            <div class="offcanvas-body">
                <div id="pendingStockContainer"></div>
                <div id="noPendingStockMsg" class="text-center mt-5" style="display: none; color: rgba(255,255,255,0.5);">
                    <i class="fas fa-check-circle mb-3" style="font-size: 3.5rem; color: #00ffaa; text-shadow: 0 0 20px #00ffaa;"></i>
                    <p>Mọi thứ đã gọn gàng!<br>Không có lệnh xuất nào đang xếp hàng.</p>
                </div>
            </div>
        </div>

        <script th:inline="javascript">
            var userRole = /*[[${session.ROLE}]]*/ 'STAFF';
            // ================== LOGIC FORM LẬP PHIẾU XUẤT ==================
            var stockOutItems = [];

            // 🌟 Hàm Tự Động Điền Giá Xuất & Số Lượng Tồn Kho
            function autoFillOutPrice() {
                const prodSelect = document.getElementById('itemProductOut');
                const priceInput = document.getElementById('itemPriceOut');
                const stockInput = document.getElementById('itemStockOut');

                if (!prodSelect) return;
                if (prodSelect.selectedIndex <= 0) {
                    if (priceInput) priceInput.value = "0";
                    if (stockInput) stockInput.value = "0";
                    return;
                }

                const selectedOption = prodSelect.options[prodSelect.selectedIndex];
                const price = parseFloat(selectedOption.getAttribute('data-price') || 0);
                const stock = parseInt(selectedOption.getAttribute('data-stock') || 0);

                if (priceInput) priceInput.value = price;
                if (stockInput) stockInput.value = stock;
            }

            function resetStockOutModal() {
                stockOutItems = [];
                const prodSelect = document.getElementById('itemProductOut');
                const qtyInput = document.getElementById('itemQtyOut');
                const priceInput = document.getElementById('itemPriceOut');
                const stockInput = document.getElementById('itemStockOut');
                if (prodSelect) prodSelect.value = "";
                if (qtyInput) qtyInput.value = "1";
                if (priceInput) priceInput.value = "0";
                if (stockInput) stockInput.value = "0";
                renderOutItemsTable();
            }

            function resetModal() {
                resetStockOutModal();
            }

            function addOutItemToList() {
                const prodSelect = document.getElementById('itemProductOut');
                if (!prodSelect) return;
                const productId = prodSelect.value;
                const productName = prodSelect.options[prodSelect.selectedIndex].text;
                const qtyInput = document.getElementById('itemQtyOut');
                const priceInput = document.getElementById('itemPriceOut');
                const stockInput = document.getElementById('itemStockOut');
                const quantity = qtyInput ? parseInt(qtyInput.value) : 1;
                const price = priceInput ? parseFloat(priceInput.value) : 0;
                const currentStock = stockInput ? parseInt(stockInput.value) : 0;

                if (!productId) { showCyberAlert("Vui lòng lựa chọn mặt hàng!", "warning"); return; }
                if (quantity <= 0) { showCyberAlert("Số lượng cấp phát phải lớn hơn 0!", "warning"); return; }

                const existingItem = stockOutItems.find(i => i.productId == productId);
                const totalRequestedQty = quantity + (existingItem ? existingItem.quantity : 0);
                if (totalRequestedQty > currentStock) {
                    showCyberAlert(`Tổng số lượng xuất của sản phẩm này (${totalRequestedQty}) vượt quá tồn kho hiện tại (${currentStock})!`, "warning");
                    return;
                }

                if (existingItem) {
                    existingItem.quantity += quantity;
                    existingItem.price = price;
                } else {
                    stockOutItems.push({ productId, productName, quantity, price });
                }
                renderOutItemsTable();
                prodSelect.value = "";
                if (qtyInput) qtyInput.value = "1";
                if (priceInput) priceInput.value = "0";
                if (stockInput) stockInput.value = "0";
            }

            function renderOutItemsTable() {
                const tbody = document.getElementById('outItemsTableBody');
                if (!tbody) return;
                tbody.innerHTML = '';
                let total = 0;
                stockOutItems.forEach((item, index) => {
                    const lineTotal = item.quantity * item.price;
                    total += lineTotal;
                    tbody.innerHTML += `
                        <tr>
                            <td style="color:#fff;">${item.productName}</td>
                            <td style="color:#00f2ff;">${item.quantity}</td>
                            <td style="color:#ffaa00;">${item.price.toLocaleString('vi-VN')}</td>
                            <td style="color:#00ffaa;">${lineTotal.toLocaleString('vi-VN')}</td>
                            <td><button class="btn btn-sm btn-outline-danger" onclick="removeOutItem(${index})"><i class="fas fa-trash"></i></button></td>
                        </tr>`;
                });
                const totalEl = document.getElementById('totalOutAmount');
                if (totalEl) totalEl.innerText = total.toLocaleString('vi-VN');
            }

            function removeOutItem(index) {
                stockOutItems.splice(index, 1);
                renderOutItemsTable();
            }

            // ================== LOGIC XEM CHI TIẾT (MẮT THẦN DỊCH ID DTO) ==================
            async function viewStockOutDetails(id) {
                const productDict = {};
                const prodOpts = document.querySelectorAll('#itemProductOut option');
                prodOpts.forEach(opt => {
                    if (opt.value) productDict[opt.value] = opt.text;
                });

                const modalEl = document.getElementById('detailStockOutModal');
                if (!modalEl) return;
                new bootstrap.Modal(modalEl).show();

                const idDisplay = document.getElementById('detailOutIdDisplay');
                if (idDisplay) idDisplay.innerText = '#PX-' + id;

                const tbody = document.getElementById('detailOutItemsBody');
                if (!tbody) return;
                tbody.innerHTML = '<tr><td colspan="4" class="text-center text-info"><i class="fas fa-spinner fa-spin me-2"></i>Đang giải mã dữ liệu...</td></tr>';

                try {
                    const response = await fetch(`/stock-out/detail/${id}`);
                    if (response.ok) {
                        const receipt = await response.json();
                        const items = receipt.items || [];
                        // 🌟 Nhận trực tiếp tổng tiền của phiếu xuất kho đã được Backend tính sẵn để hiển thị ngay lập tức
                        const total = receipt.totalAmount || 0;
                        let tbodyHtml = '';

                        if (items.length === 0) {
                            tbodyHtml = '<tr><td colspan="4" class="text-center text-muted">Phiếu xuất rỗng!</td></tr>';
                        } else {
                            items.forEach(item => {
                                const prodName = productDict[item.productId] || ('Sản phẩm ID: ' + item.productId);
                                const lineTotal = item.quantity * item.price;
                                tbodyHtml += `
                                    <tr>
                                        <td style="color:#fff;">${prodName}</td>
                                        <td style="color:#00f2ff; font-weight:bold;">${item.quantity}</td>
                                        <td style="color:#ffaa00;">${item.price.toLocaleString('vi-VN')}</td>
                                        <td style="color:#00ffaa;">${lineTotal.toLocaleString('vi-VN')}</td>
                                    </tr>`;
                            });
                        }
                        tbody.innerHTML = tbodyHtml;
                        const totalEl = document.getElementById('detailOutTotalAmount');
                        // 🌟 Gán giá trị tổng tiền đã format bằng tiền tệ vi-VN
                        if (totalEl) totalEl.innerText = total.toLocaleString('vi-VN');
                    } else {
                        tbody.innerHTML = `<tr><td colspan="4" class="text-center text-danger">Lỗi: ${await response.text()}</td></tr>`;
                        errorlog("Lỗi khi lấy chi tiết phiếu xuất:", await response.text());
                    }
                } catch (error) { tbody.innerHTML = '<tr><td colspan="4" class="text-center text-danger">Lỗi kết nối!</td></tr>'; }
            }

            // ================== LOGIC OFFCANVAS NGĂN KÉO CHỜ DUYỆT XUẤT ==================
            async function openPendingStockOutPanel() {
                const container = document.getElementById('pendingStockContainer');
                const noMsg = document.getElementById('noPendingStockMsg');
                if (!container || !noMsg) return;
                
                container.innerHTML = `<div class="text-center mt-5"><div class="spinner-border text-warning" role="status"></div><p class="mt-3 text-warning">Đang quét luồng chứng từ...</p></div>`;
                noMsg.style.display = 'none';

                const offcanvasEl = document.getElementById('pendingStockOffcanvas');
                if (offcanvasEl) new bootstrap.Offcanvas(offcanvasEl).show();

                try {
                    const response = await fetch('/stock-out/pending');
                    if (response.ok) {
                        const pendingList = await response.json();
                        container.innerHTML = '';
                        if (pendingList.length > 0) {
                            pendingList.forEach(s => {
                                const card = document.createElement('div');
                                card.className = 'card mb-3';
                                card.style = 'background: rgba(0,0,0,0.4); border: 1px solid rgba(255,170,0,0.3); border-radius: 12px;';
                                card.innerHTML = `
                                    <div class="card-body d-flex justify-content-between align-items-center p-3">
                                        <div>
                                            <h6 style="color:#00f2ff; margin:0; font-weight:bold;"><i class="fas fa-file-invoice me-2"></i>#PX-${s.id}</h6>
                                            <small style="color:rgba(255,255,255,0.6);">${s.createdAt ? s.createdAt.substring(0,10) : '---'}</small>
                                        </div>
                                        <div class="text-end">
                                            <button class="btn btn-sm btn-outline-primary rounded-circle me-1" style="width:32px; height:32px; padding:0;" onclick="viewStockOutDetails('${s.id}')"><i class="fas fa-eye"></i></button>
                                            ${userRole === 'ADMIN' ? `
                                            <button class="btn btn-sm btn-outline-info rounded-circle me-1" style="width:32px; height:32px; padding:0;" onclick="showApproveOutModal(this, '${s.id}')"><i class="fas fa-check"></i></button>
                                            <button class="btn btn-sm btn-outline-danger rounded-circle" style="width:32px; height:32px; padding:0;" onclick="showCancelOutModal(this, '${s.id}')"><i class="fas fa-times"></i></button>
                                            ` : ''}
                                        </div>
                                    </div>`;
                                container.appendChild(card);
                            });
                        } else { noMsg.style.display = 'block'; }
                    } else { container.innerHTML = `<p class="text-center text-danger mt-5">Lỗi kết nối</p>`; }
                } catch (error) { container.innerHTML = `<p class="text-center text-danger mt-5">Mất kết nối máy chủ!</p>`;
                    console.log("lỗi");
                }
            }

            // ================== LOGIC DUYỆT / HỦY PHIẾU XUẤT ĐỒNG BỘ ==================
            function showApproveOutModal(btn, id) {
                const targetIdEl = document.getElementById('approveOutTargetId');
                const targetNameEl = document.getElementById('approveOutTargetName');
                if (targetIdEl) targetIdEl.value = id;
                if (targetNameEl) targetNameEl.innerText = '#PX-' + id;
                
                const modalEl = document.getElementById('approveStockOutModal');
                if (modalEl) new bootstrap.Modal(modalEl).show();
            }

            function showCancelOutModal(btn, id) {
                const targetIdEl = document.getElementById('cancelOutTargetId');
                const targetNameEl = document.getElementById('cancelOutTargetName');
                if (targetIdEl) targetIdEl.value = id;
                if (targetNameEl) targetNameEl.innerText = '#PX-' + id;
                
                const modalEl = document.getElementById('cancelStockOutModal');
                if (modalEl) new bootstrap.Modal(modalEl).show();
            }

            // 🌟 1. LƯU PHIẾU XUẤT
            async function saveStockOut() {
                if (stockOutItems.length === 0) { showCyberAlert("Hóa đơn chưa có mặt hàng nào!", "warning"); return; }
                const customerIdEl = document.getElementById('customerId');
                const itemsToSend = stockOutItems.map(item => ({
                    productId: item.productId,
                    quantity: item.quantity,
                    price: item.price
                }));
                const payload = { 
                    customerId: customerIdEl ? parseInt(customerIdEl.value) : null, 
                    items: itemsToSend 
                };

                try {
                    const response = await fetch('/stock-out/save', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });

                    if (response.ok) {
                        const myModalEl = document.getElementById('crudModal');
                        if (myModalEl) {
                            const modalInstance = bootstrap.Modal.getInstance(myModalEl);
                            if (modalInstance) modalInstance.hide();
                            else {
                                const closeBtn = document.querySelector('#crudModal .btn-close');
                                if (closeBtn) closeBtn.click();
                            }
                        }

                        showCyberAlert("Đã khởi tạo phiếu xuất PENDING thành công!", "success");
                        resetStockOutModal();

                        // Chiêu thức tối thượng cực kỳ an toàn
                        reloadTableData('stock-out-data-container');
                    } else {
                        showCyberAlert("Lỗi hệ thống: " + await response.text(), "error");
                    }
                } catch (error) {
                    console.error("🔥 BẮT ĐƯỢC LỖI JS:", error);
                    showCyberAlert("Lỗi Code: " + error.message, "error");
                    console.log(error.message);
                }
            }

            // 🌟 2. DUYỆT PHIẾU XUẤT
            async function executeApproveStockOut() {
                const targetIdEl = document.getElementById('approveOutTargetId');
                if (!targetIdEl) return;
                const id = targetIdEl.value;
                try {
                    const response = await fetch(`/stock-out/status/${id}?status=COMPLETED`, { method: 'PUT' });
                    if (response.ok) {
                        const approveModalEl = document.getElementById('approveStockOutModal');
                        if (approveModalEl) {
                            const approveInstance = bootstrap.Modal.getInstance(approveModalEl);
                            if (approveInstance) approveInstance.hide();
                            else {
                                const closeBtn = document.querySelector('#approveStockOutModal .btn-close');
                                if (closeBtn) closeBtn.click();
                            }
                        }

                        showCyberAlert("Đã xuất kho và chốt trừ tồn kho!", "success");

                        // Chiêu thức tối thượng cực kỳ an toàn
                        reloadTableData('stock-out-data-container');

                        const offcanvasEl = document.getElementById('pendingStockOffcanvas');
                        if (offcanvasEl && offcanvasEl.classList.contains('show')) openPendingStockOutPanel();
                    } else {
                        showCyberAlert("Thao tác thất bại: " + await response.text(), "error");
                    }
                } catch (error) {
                    console.error("🔥 BẮT ĐƯỢC LỖI JS:", error);
                    showCyberAlert("Lỗi Code: " + error.message, "error");
                }
            }

            // 🌟 3. HỦY PHIẾU XUẤT
            async function executeCancelStockOut() {
                const targetIdEl = document.getElementById('cancelOutTargetId');
                if (!targetIdEl) return;
                const id = targetIdEl.value;
                try {
                    const response = await fetch(`/stock-out/status/${id}?status=CANCELLED`, { method: 'PUT' });
                    if (response.ok) {
                        const cancelModalEl = document.getElementById('cancelStockOutModal');
                        if (cancelModalEl) {
                            const cancelInstance = bootstrap.Modal.getInstance(cancelModalEl);
                            if (cancelInstance) cancelInstance.hide();
                            else {
                                const closeBtn = document.querySelector('#cancelStockOutModal .btn-close');
                                if (closeBtn) closeBtn.click();
                            }
                        }

                        showCyberAlert("Đã hủy bỏ chứng từ thành công!", "success");

                        // Chiêu thức tối thượng cực kỳ an toàn
                        reloadTableData('stock-out-data-container');

                        const offcanvasEl = document.getElementById('pendingStockOffcanvas');
                        if (offcanvasEl && offcanvasEl.classList.contains('show')) openPendingStockOutPanel();
                    } else {
                        showCyberAlert("Lỗi: " + await response.text(), "error");
                    }
                } catch (error) {
                    console.error("🔥 BẮT ĐƯỢC LỖI JS:", error);
                    showCyberAlert("Lỗi Code: " + error.message, "error");
                }
            }

            // ================== LOGIC XUẤT EXCEL THEO KHOẢNG NGÀY CHUYÊN NGHIỆP ==================
            var exportExcelModal = document.getElementById('exportExcelModal');
            if (exportExcelModal) {
                exportExcelModal.addEventListener('show.bs.modal', function () {
                    const now = new Date();
                    const year = now.getFullYear();
                    const month = String(now.getMonth() + 1).padStart(2, '0');
                    const day = String(now.getDate()).padStart(2, '0');
                    
                    document.getElementById('exportEndDate').value = `${year}-${month}-${day}`;
                    document.getElementById('exportStartDate').value = `${year}-${month}-01`;
                    
                    const btn = document.getElementById('btnConfirmExport');
                    if (btn) {
                        btn.disabled = false;
                        btn.innerHTML = '<i class="fas fa-file-export me-2"></i>Xác Nhận Xuất';
                    }
                });
            }

            async function executeExcelExport() {
                const startDate = document.getElementById('exportStartDate').value;
                const endDate = document.getElementById('exportEndDate').value;
                const status = document.getElementById('exportStatus').value;

                if (!startDate || !endDate) {
                    showCyberAlert("Vui lòng chọn đầy đủ khoảng ngày!", "warning");
                    return;
                }

                if (new Date(startDate) > new Date(endDate)) {
                    showCyberAlert("Ngày bắt đầu không được lớn hơn ngày kết thúc!", "warning");
                    return;
                }

                const btn = document.getElementById('btnConfirmExport');
                const originalHtml = btn.innerHTML;
                
                // Hiệu ứng Spinner Neon xoay nhấp nháy
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Đang khởi tạo...';

                try {
                    const downloadUrl = `/api/export/stock-out?startDate=${startDate}&endDate=${endDate}&status=${status}`;
                    
                    // Giả lập 800ms chờ đợi Cyberpunk xử lý
                    setTimeout(() => {
                        window.location.href = downloadUrl;
                        
                        const modalEl = document.getElementById('exportExcelModal');
                        const modalInstance = bootstrap.Modal.getInstance(modalEl);
                        if (modalInstance) modalInstance.hide();
                        
                        showCyberAlert("Báo cáo Excel đang được tải xuống!", "success");
                    }, 800);

                } catch (error) {
                    showCyberAlert("Lỗi tải xuống báo cáo!", "error");
                    btn.disabled = false;
                    btn.innerHTML = originalHtml;
                }
            }
        </script>
    </main>
</div>
<div th:replace="~{common/scripts :: footer_scripts}"></div>
</body>
</html>
</file>

<file path="FE_JAVA2/FEJAVA2/src/main/resources/templates/suppliers.html">
<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org" lang="vi">

<head th:replace="~{common/head :: head_info('Nhà Cung Cấp - Hệ Thống Quản Lý Kho')}"></head>

<body>
<div id="vanta-canvas"></div>

<div class="container-fluid p-0">
    <nav th:replace="~{common/sidebar :: sidebar_menu('suppliers')}"></nav>

    <main class="main-content">
        <div th:replace="~{common/styles}"></div>
        <div th:replace="~{common/page-header :: top_header('Cơ Sở Dữ Liệu Nhà Cung Cấp', 'Quản Lý Đối Tác')}"></div>

        <div th:replace="~{common/action-bar :: crud_bar('Nhà Cung Cấp', 'Tìm tên nhà cung cấp...')}"></div>

        <div id="supplier-data-container">
            <div th:replace="~{common/table-card :: ajax_data_grid(
                ~{::table},
                ~{common/pagination-par :: pagination_bar(${currentPage}, ${totalPages}, '/suppliers', 'supplier-data-container')}
            )}">
                <table class="table">
                    <thead>
                    <tr>
                        <th><i class="fas fa-hashtag" style="margin-right: 8px;"></i>STT</th>
                        <th><i class="fas fa-building" style="margin-right: 8px;"></i>Tên Nhà Cung Cấp</th>
                        <th><i class="fas fa-phone" style="margin-right: 8px;"></i>SĐT Đối Tác</th>
                        <th><i class="fas fa-map-marker-alt" style="margin-right: 8px;"></i>Địa Chỉ</th>
                        <th th:if="${session.ROLE == 'ADMIN'}" class="text-end"><i class="fas fa-cogs" style="margin-right: 8px;"></i>Thao Tác</th>
                    </tr>
                    </thead>
                    <tbody>
                    <tr th:each="s, iterStat : ${list}">
                        <td th:text="${(currentPage * pageSize) + iterStat.count}" style="color: rgba(0, 242, 255, 0.7);"></td>
                        <td th:text="${s.name}" style="color: #e0e0e0; font-weight: 600;"></td>
                        <td class="price-tag" th:text="${s.phone}"></td>
                        <td style="color: #a0a0a0;" th:text="${s.address}"></td>
                        <td th:if="${session.ROLE == 'ADMIN'}" class="text-end">
                            <button class="btn btn-sm btn-outline-info rounded-circle me-1"
                                    style="width: 32px; height: 32px; padding: 0;"
                                    th:data-id="${s.id}"
                                    th:data-name="${s.name}"
                                    th:data-phone="${s.phone}"
                                    th:data-address="${s.address}"
                                    onclick="openEditModal(this.dataset.id, this.dataset.name, this.dataset.phone, this.dataset.address)">
                                <i class="fas fa-pen"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger rounded-circle"
                                    style="width: 32px; height: 32px; padding: 0;"
                                    th:data-id="${s.id}"
                                    th:data-name="${s.name}"
                                    onclick="deleteSupplier(this.dataset.id, this.dataset.name)">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="modal fade" id="crudModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content" style="background: rgba(10, 15, 20, 0.95); backdrop-filter: blur(20px); border: 1px solid #00f2ff; box-shadow: 0 0 30px rgba(0, 242, 255, 0.2);">
                    <div class="modal-header" style="border-bottom: 1px solid rgba(0, 242, 255, 0.2);">
                        <h5 class="modal-title" id="modalTitle" style="color: #00f2ff; font-weight: 600; font-family: 'Poppins', sans-serif;">
                            <i class="fas fa-plus-circle me-2"></i>Thêm Nhà Cung Cấp
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="supId">
                        <div class="mb-3">
                            <label class="form-label" style="color: rgba(255,255,255,0.7); font-size: 0.85rem;">Tên nhà cung cấp (*)</label>
                            <input type="text" id="supName" class="form-control border-cyber text-white" style="background: rgba(0,0,0,0.5); transition: all 0.3s;" placeholder="Nhập tên đối tác...">
                        </div>
                        <div class="mb-3">
                            <label class="form-label" style="color: rgba(255,255,255,0.7); font-size: 0.85rem;">Số điện thoại liên hệ (*)</label>
                            <input type="text" id="supPhone" class="form-control border-cyber text-white" style="background: rgba(0,0,0,0.5); transition: all 0.3s;" placeholder="Nhập SĐT...">
                        </div>
                        <div class="mb-3">
                            <label class="form-label" style="color: rgba(255,255,255,0.7); font-size: 0.85rem;">Địa chỉ công ty</label>
                            <input type="text" id="supAddress" class="form-control border-cyber text-white" style="background: rgba(0,0,0,0.5);" placeholder="Nhập địa chỉ...">
                        </div>
                    </div>
                    <div class="modal-footer" style="border-top: 1px solid rgba(0, 242, 255, 0.2);">
                        <button type="button" class="btn btn-cyber btn-cyber-secondary" data-bs-dismiss="modal">Hủy Bỏ</button>
                        <button type="button" class="btn btn-cyber btn-cyber-success" onclick="saveSupplier()">
                            <i class="fas fa-save me-2"></i>Lưu Dữ Liệu
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-sm">
                <div class="modal-content" style="background: rgba(15, 5, 5, 0.95); backdrop-filter: blur(20px); border: 1px solid #ff003c; box-shadow: 0 0 30px rgba(255, 0, 60, 0.2);">
                    <div class="modal-header" style="border-bottom: 1px solid rgba(255, 0, 60, 0.2);">
                        <h5 class="modal-title" style="color: #ff003c; font-weight: 600;"><i class="fas fa-exclamation-triangle me-2"></i>Cảnh Báo</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body text-center py-4">
                        <i class="fas fa-trash-alt mb-3" style="font-size: 3rem; color: #ff003c; text-shadow: 0 0 15px rgba(255,0,60,0.6);"></i>
                        <p style="color: #ffffff; font-size: 1rem;">Ngừng hợp tác với:</p>
                        <h4 id="deleteTargetName" style="color: #ff003c; font-weight: bold;">---</h4>
                        <input type="hidden" id="deleteTargetId">
                    </div>
                    <div class="modal-footer d-flex justify-content-center" style="border-top: 1px solid rgba(255, 0, 60, 0.2);">
                        <button type="button" class="btn btn-cyber btn-cyber-secondary" data-bs-dismiss="modal">Quay Lại</button>
                        <button type="button" class="btn btn-cyber btn-cyber-danger" onclick="executeDelete()">Xác Nhận Xóa</button>
                    </div>
                </div>
            </div>
        </div>

        <script>
            function resetSupplierModal() {
                document.getElementById('modalTitle').innerHTML = '<i class="fas fa-plus-circle me-2"></i>Thêm Nhà Cung Cấp';
                document.getElementById('supId').value = '';
                document.getElementById('supName').value = '';
                document.getElementById('supPhone').value = '';
                document.getElementById('supAddress').value = '';
                if(typeof hideModalError === "function") hideModalError();
            }

            function resetModal() {
                resetSupplierModal();
            }

            function openEditModal(id, name, phone, address) {
                document.getElementById('modalTitle').innerHTML = '<i class="fas fa-pen me-2"></i>Cập Nhật Nhà Cung Cấp';
                document.getElementById('supId').value = id;
                document.getElementById('supName').value = name;
                document.getElementById('supPhone').value = (phone === 'null' || !phone) ? '' : phone;
                document.getElementById('supAddress').value = (address === 'null' || !address) ? '' : address;
                if(typeof hideModalError === "function") hideModalError();
                var myModal = new bootstrap.Modal(document.getElementById('crudModal'));
                myModal.show();
            }

            async function saveSupplier() {
                if(typeof hideModalError === "function") hideModalError();

                const id = document.getElementById('supId').value;
                const name = document.getElementById('supName').value.trim();
                const phone = document.getElementById('supPhone').value.trim();
                const address = document.getElementById('supAddress').value.trim();

                // Check trống Tên
                if (!name) {
                    if(typeof showModalError === "function") showModalError("Tên nhà cung cấp không được để trống!", "supName");
                    return;
                }

                // Cảnh báo thêm: Trống SĐT (tùy đại ca có muốn bắt buộc không)
                if (!phone) {
                    if(typeof showModalError === "function") showModalError("Cần nhập số điện thoại để tiện liên lạc!", "supPhone");
                    return;
                }

                const payload = {
                    id: id ? parseInt(id) : null,
                    name: name,
                    phone: phone,
                    address: address
                };

                try {
                    const response = await fetch('/suppliers/save', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });

                    if (response.ok) {
                        bootstrap.Modal.getInstance(document.getElementById('crudModal')).hide();
                        if(typeof showSuccessToast === "function") showSuccessToast("Đã lưu thông tin nhà cung cấp!");

                        const activePageBtn = document.querySelector('.page-item.active .ajax-page-link');
                        if (activePageBtn) activePageBtn.click();
                        else reloadTableData('supplier-data-container');
                    } else {
                        const errText = await response.text();
                        // 🌟 NẾU LỖI TRÙNG SĐT -> BẬT VIỀN ĐỎ TẠI Ô "supPhone"
                        if(typeof showModalError === "function") showModalError(errText, "supPhone");
                    }
                } catch (error) {
                    if(typeof showModalError === "function") showModalError("Lỗi kết nối máy chủ!", "supName");
                }
            }

            function deleteSupplier(id, name) {
                document.getElementById('deleteTargetId').value = id;
                document.getElementById('deleteTargetName').innerText = name;
                new bootstrap.Modal(document.getElementById('deleteModal')).show();
            }

            async function executeDelete() {
                const id = document.getElementById('deleteTargetId').value;
                try {
                    const response = await fetch(`/suppliers/delete/${id}`, { method: 'DELETE' });
                    if (response.ok) {
                        bootstrap.Modal.getInstance(document.getElementById('deleteModal')).hide();
                        if(typeof showSuccessToast === "function") showSuccessToast("Đã xóa nhà cung cấp thành công!");
                        const activePageBtn = document.querySelector('.page-item.active .ajax-page-link');
                        if (activePageBtn) activePageBtn.click();
                        else reloadTableData('supplier-data-container');
                    } else {
                        alert("Xóa thất bại!");
                    }
                } catch (error) { console.error(error); }
            }
        </script>
    </main>
</div>

<div th:replace="~{common/scripts :: footer_scripts}"></div>
</body>
</html>
</file>

<file path="FE_JAVA2/FEJAVA2/src/main/resources/templates/users.html">
<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org" lang="vi">

<head th:replace="~{common/head :: head_info('Tài Khoản - Hệ Thống Quản Lý Kho')}"></head>

<body>
<div id="vanta-canvas"></div>

<div class="container-fluid p-0">
    <nav th:replace="~{common/sidebar :: sidebar_menu('users')}"></nav>

    <main class="main-content">
        <div th:replace="~{common/styles}"></div>
        <div th:replace="~{common/page-header :: top_header('Quản Trị Người Dùng', 'Bảo Mật Hệ Thống')}"></div>

        <div th:replace="~{common/action-bar :: crud_bar('Tài Khoản', 'Tìm tài khoản, họ tên, sđt...')}"></div>

        <div id="user-data-container">
            <div th:replace="~{common/table-card :: ajax_data_grid(
                ~{::table},
                ~{common/pagination-par :: pagination_bar(${currentPage}, ${totalPages}, '/users', 'user-data-container')}
            )}">
                <table class="table">
                    <thead>
                    <tr>
                        <th><i class="fas fa-hashtag" style="margin-right: 8px;"></i>STT</th>
                        <th><i class="fas fa-user" style="margin-right: 8px;"></i>Tài Khoản</th>
                        <th><i class="fas fa-id-card" style="margin-right: 8px;"></i>Họ Và Tên</th>
                        <th><i class="fas fa-phone" style="margin-right: 8px;"></i>Số Điện thoại</th>
                        <th><i class="fas fa-envelope" style="margin-right: 8px;"></i>Email</th>
                        <th><i class="fas fa-user-shield" style="margin-right: 8px;"></i>Cấp Quyền</th>
                        <th><i class="fas fa-toggle-on" style="margin-right: 8px;"></i>Trạng Thái</th>
                        <th class="text-end"><i class="fas fa-cogs" style="margin-right: 8px;"></i>Thao Tác</th>
                    </tr>
                    </thead>
                    <tbody>
                    <tr th:each="u, iterStat : ${list}">
                        <td th:text="${(currentPage * pageSize) + iterStat.count}" style="color: rgba(0, 242, 255, 0.7);"></td>
                        <td th:text="${u.username}" style="color: #ffffff; font-weight: bold;"></td>
                        <td th:text="${u.fullName != null ? u.fullName : '---'}" style="color: #e0e0e0;"></td>
                        <td th:text="${u.phone != null ? u.phone : '---'}" style="color: #00f2ff;"></td>
                        <td th:text="${u.email != null ? u.email : '---'}" style="color: #a0a0a0;"></td>
                        <td>
                            <span th:if="${u.role == 'ADMIN'}" class="badge" style="background: rgba(255, 0, 128, 0.2); color: #ff0080; border: 1px solid rgba(255, 0, 128, 0.4);">ADMIN</span>
                            <span th:if="${u.role == 'STAFF'}" class="badge" style="background: rgba(0, 255, 170, 0.2); color: #00ffaa; border: 1px solid rgba(0, 255, 170, 0.4);">STAFF</span>
                        </td>
                        <td>
                            <span th:if="${u.status == 'ACTIVE'}" class="badge" style="background: rgba(0, 255, 100, 0.15); color: #00ff64; border: 1px solid #00ff64;">ACTIVE</span>
                            <span th:if="${u.status == 'PENDING'}" class="badge" style="background: rgba(255, 200, 0, 0.15); color: #ffc800; border: 1px solid #ffc800;">PENDING</span>
                            <span th:if="${u.status == 'INACTIVE'}" class="badge" style="background: rgba(255, 0, 50, 0.15); color: #ff0032; border: 1px solid #ff0032;">INACTIVE</span>
                        </td>
                        <td class="text-end">
                            <span th:if="${u.role == 'ADMIN'}" class="badge" style="background: rgba(255, 255, 255, 0.05); color: rgba(255, 255, 255, 0.3); border: 1px dashed rgba(255, 255, 255, 0.2);">
                                <i class="fas fa-shield-alt me-1"></i> Không thể chạm
                            </span>

                            <div th:if="${u.role != 'ADMIN'}" class="d-inline-block">
                                <button th:if="${u.status == 'PENDING'}" class="btn btn-sm btn-outline-info rounded-circle me-1"
                                        style="width: 32px; height: 32px; padding: 0;" title="Duyệt tài khoản"
                                        th:data-id="${u.id}" th:data-username="${u.username}"
                                        onclick="approveUser(this.dataset.id, this.dataset.username)">
                                    <i class="fas fa-user-check"></i>
                                </button>

                                <button th:if="${u.status == 'INACTIVE'}" class="btn btn-sm btn-outline-success rounded-circle me-1"
                                        style="width: 32px; height: 32px; padding: 0;" title="Mở khóa tài khoản"
                                        th:data-id="${u.id}" th:data-username="${u.username}"
                                        onclick="unlockUser(this.dataset.id, this.dataset.username)">
                                    <i class="fas fa-unlock"></i>
                                </button>

                                <button th:if="${u.status == 'ACTIVE'}" class="btn btn-sm btn-outline-warning rounded-circle me-1"
                                        style="width: 32px; height: 32px; padding: 0;" title="Khóa tài khoản"
                                        th:data-id="${u.id}" th:data-username="${u.username}"
                                        onclick="lockUser(this.dataset.id, this.dataset.username)">
                                    <i class="fas fa-lock"></i>
                                </button>

                                <button class="btn btn-sm btn-outline-danger rounded-circle"
                                        style="width: 32px; height: 32px; padding: 0;" title="Xóa vĩnh viễn"
                                        th:data-id="${u.id}" th:data-username="${u.username}"
                                        onclick="deleteUser(this.dataset.id, this.dataset.username)">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="modal fade" id="crudModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content" style="background: rgba(10, 15, 20, 0.95); backdrop-filter: blur(20px); border: 1px solid #00f2ff;">
                    <div class="modal-header" style="border-bottom: 1px solid rgba(0, 242, 255, 0.2);">
                        <h5 class="modal-title" style="color: #00f2ff; font-weight: 600;"><i class="fas fa-user-plus me-2"></i>Cấp Tài Khoản Mới</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <input type="text" style="opacity: 0; position: absolute; z-index: -1;" tabindex="-1">
                        <input type="password" style="opacity: 0; position: absolute; z-index: -1;" tabindex="-1">

                        <div class="mb-3">
                            <label class="form-label" style="color: rgba(255,255,255,0.7); font-size: 0.85rem;">Tên Đăng Nhập (*)</label>
                            <input type="text" id="userName" class="form-control border-cyber text-white" style="background: rgba(0,0,0,0.5);" placeholder="Nhập username..." autocomplete="new-password">
                        </div>
                        <div class="mb-3">
                            <label class="form-label" style="color: rgba(255,255,255,0.7); font-size: 0.85rem;">Mật Khẩu (*)</label>
                            <input type="password" id="userPass" class="form-control border-cyber text-white" style="background: rgba(0,0,0,0.5);" placeholder="Nhập mật khẩu..." autocomplete="new-password">
                        </div>
                        <div class="mb-3">
                            <label class="form-label" style="color: rgba(255,255,255,0.7); font-size: 0.85rem;">Họ Và Tên</label>
                            <input type="text" id="userFullName" class="form-control border-cyber text-white" style="background: rgba(0,0,0,0.5);" placeholder="Nhập họ tên nhân viên...">
                        </div>
                        <div class="mb-3">
                            <label class="form-label" style="color: rgba(255,255,255,0.7); font-size: 0.85rem;">Số Điện Thoại</label>
                            <input type="text" id="userPhone" class="form-control border-cyber text-white" style="background: rgba(0,0,0,0.5);" placeholder="Nhập số điện thoại...">
                        </div>
                        <div class="mb-3">
                            <label class="form-label" style="color: rgba(255,255,255,0.7); font-size: 0.85rem;">Email</label>
                            <input type="email" id="userEmail" class="form-control border-cyber text-white" style="background: rgba(0,0,0,0.5);" placeholder="Nhập email...">
                        </div>
                        <div class="mb-3">
                            <label class="form-label" style="color: rgba(255,255,255,0.7); font-size: 0.85rem;">Cấp Quyền</label>
                            <select id="userRole" class="form-select border-cyber text-white" style="background: rgba(0,0,0,0.5);">
                                <option value="STAFF">Nhân Viên (STAFF)</option>
                                <option value="ADMIN">Quản Trị Viên (ADMIN)</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer" style="border-top: 1px solid rgba(0, 242, 255, 0.2);">
                        <button type="button" class="btn btn-cyber btn-cyber-secondary" data-bs-dismiss="modal">Hủy</button>
                        <button type="button" class="btn btn-cyber btn-cyber-success" onclick="saveUser()"><i class="fas fa-save me-2"></i>Tạo Tài Khoản</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-sm">
                <div class="modal-content" style="background: rgba(15, 5, 5, 0.95); border: 1px solid #ff003c;">
                    <div class="modal-header" style="border-bottom: 1px solid rgba(255, 0, 60, 0.2);">
                        <h5 class="modal-title" style="color: #ff003c; font-weight: 600;"><i class="fas fa-exclamation-triangle me-2"></i>Cảnh Báo</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body text-center py-4">
                        <i class="fas fa-user-slash mb-3" style="font-size: 3rem; color: #ff003c;"></i>
                        <p style="color: #ffffff;">Thu hồi hoàn toàn tài khoản:</p>
                        <h4 id="deleteTargetName" style="color: #ff003c; font-weight: bold;">---</h4>
                        <input type="hidden" id="deleteTargetId">
                    </div>
                    <div class="modal-footer d-flex justify-content-center" style="border-top: 1px solid rgba(255, 0, 60, 0.2);">
                        <button type="button" class="btn btn-cyber btn-cyber-secondary" data-bs-dismiss="modal">Hủy</button>
                        <button type="button" class="btn btn-cyber btn-cyber-danger" onclick="executeDelete()"><i class="fas fa-skull me-2"></i>Xóa</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="lockModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-sm">
                <div class="modal-content" style="background: rgba(15, 10, 5, 0.95); border: 1px solid #ffaa00;">
                    <div class="modal-header" style="border-bottom: 1px solid rgba(255, 170, 0, 0.2);">
                        <h5 class="modal-title" style="color: #ffaa00; font-weight: 600;"><i class="fas fa-user-lock me-2"></i>Vô Hiệu Hóa</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body text-center py-4">
                        <i class="fas fa-lock mb-3" style="font-size: 3rem; color: #ffaa00;"></i>
                        <p style="color: #ffffff;">Đình chỉ hoạt động tài khoản:</p>
                        <h4 id="lockTargetName" style="color: #ffaa00; font-weight: bold;">---</h4>
                        <input type="hidden" id="lockTargetId">
                    </div>
                    <div class="modal-footer d-flex justify-content-center" style="border-top: 1px solid rgba(255, 170, 0, 0.2);">
                        <button type="button" class="btn btn-cyber btn-cyber-secondary" data-bs-dismiss="modal">Hủy</button>
                        <button type="button" class="btn btn-cyber btn-cyber-warning" style="background: rgba(255, 170, 0, 0.2); color: #ffaa00; border: 1px solid #ffaa00;" onclick="executeLock()"><i class="fas fa-ban me-2"></i>Khóa Ngay</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="unlockModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-sm">
                <div class="modal-content" style="background: rgba(5, 15, 10, 0.95); border: 1px solid #00ff64;">
                    <div class="modal-header" style="border-bottom: 1px solid rgba(0, 255, 100, 0.2);">
                        <h5 class="modal-title" style="color: #00ff64; font-weight: 600;"><i class="fas fa-lock-open me-2"></i>Mở Khóa</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body text-center py-4">
                        <i class="fas fa-unlock mb-3" style="font-size: 3rem; color: #00ff64;"></i>
                        <p style="color: #ffffff;">Khôi phục quyền truy cập cho:</p>
                        <h4 id="unlockTargetName" style="color: #00ff64; font-weight: bold;">---</h4>
                        <input type="hidden" id="unlockTargetId">
                    </div>
                    <div class="modal-footer d-flex justify-content-center" style="border-top: 1px solid rgba(0, 255, 100, 0.2);">
                        <button type="button" class="btn btn-cyber btn-cyber-secondary" data-bs-dismiss="modal">Hủy</button>
                        <button type="button" class="btn btn-cyber btn-cyber-success" style="background: rgba(0, 255, 100, 0.2); color: #00ff64; border: 1px solid #00ff64;" onclick="executeUnlock()"><i class="fas fa-check me-2"></i>Mở Ngay</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="approveModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-sm">
                <div class="modal-content" style="background: rgba(5, 15, 25, 0.95); border: 1px solid #00f2ff;">
                    <div class="modal-header" style="border-bottom: 1px solid rgba(0, 242, 255, 0.2);">
                        <h5 class="modal-title" style="color: #00f2ff; font-weight: 600;"><i class="fas fa-user-check me-2"></i>Phê Duyệt</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body text-center py-4">
                        <i class="fas fa-check-circle mb-3" style="font-size: 3rem; color: #00f2ff;"></i>
                        <p style="color: #ffffff;">Chấp nhận tài khoản tham gia hệ thống:</p>
                        <h4 id="approveTargetName" style="color: #00f2ff; font-weight: bold;">---</h4>
                        <input type="hidden" id="approveTargetId">
                    </div>
                    <div class="modal-footer d-flex justify-content-center" style="border-top: 1px solid rgba(0, 242, 255, 0.2);">
                        <button type="button" class="btn btn-cyber btn-cyber-secondary" data-bs-dismiss="modal">Hủy</button>
                        <button type="button" class="btn btn-cyber btn-cyber-info" style="background: rgba(0, 242, 255, 0.2); color: #00f2ff; border: 1px solid #00f2ff;" onclick="executeApprove()"><i class="fas fa-check me-2"></i>Duyệt Ngay</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="offcanvas offcanvas-end" tabindex="-1" id="pendingOffcanvas" style="background: rgba(10, 15, 20, 0.98); backdrop-filter: blur(20px); border-left: 1px solid #ffc800; width: 400px;">
            <div class="offcanvas-header" style="border-bottom: 1px solid rgba(255, 200, 0, 0.2);">
                <h5 class="offcanvas-title" style="color: #ffc800; font-weight: 600;">
                    <i class="fas fa-user-clock me-2"></i>Danh Sách Chờ Duyệt
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
            </div>
            <div class="offcanvas-body">
                <div id="pendingUsersContainer">
                </div>

                <div id="noPendingMsg" class="text-center mt-5" style="display: none; color: rgba(255,255,255,0.5);">
                    <i class="fas fa-check-circle mb-3" style="font-size: 3.5rem; color: #00ff64; text-shadow: 0 0 20px #00ff64;"></i>
                    <p>Mọi thứ đã gọn gàng!<br>Không có tài khoản nào đang chờ duyệt.</p>
                </div>
            </div>
        </div>

        <script>
            // Hàm quét bảng và mở Menu trượt (Offcanvas)
            // 🌟 HÀM QUÉT DANH SÁCH CHỜ DUYỆT BẰNG API (LẤY TẤT CẢ DATA)
            async function openPendingPanel() {
                const container = document.getElementById('pendingUsersContainer');
                const noMsg = document.getElementById('noPendingMsg');

                // Mở Offcanvas và hiện hiệu ứng xoay xoay đang tải
                container.innerHTML = `
                    <div class="text-center mt-5">
                        <div class="spinner-border text-warning" style="width: 3rem; height: 3rem;" role="status"></div>
                        <p class="mt-3" style="color: #ffc800;">Đang kết nối Database lấy danh sách...</p>
                    </div>`;
                noMsg.style.display = 'none';
                new bootstrap.Offcanvas(document.getElementById('pendingOffcanvas')).show();

                try {
                    // Gọi ngầm API Frontend -> Backend -> Database
                    const response = await fetch('/users/pending');

                    if (response.ok) {
                        const pendingUsers = await response.json(); // Nhận 1 mảng JSON chứa các User PENDING
                        container.innerHTML = ''; // Xóa vòng xoay

                        if (pendingUsers.length > 0) {
                            // Dùng vòng lặp nhét data vào thẻ Card
                            pendingUsers.forEach(u => {
                                const card = document.createElement('div');
                                card.className = 'card mb-3';
                                card.style = 'background: rgba(0,0,0,0.4); border: 1px solid rgba(255,200,0,0.3); border-radius: 12px; transition: all 0.3s;';
                                card.innerHTML = `
                                    <div class="card-body d-flex justify-content-between align-items-center p-3">
                                        <div>
                                            <h6 style="color: #ffffff; margin:0; font-weight:bold;"><i class="fas fa-user me-2" style="color: #ffc800;"></i>${u.username}</h6>
                                            <small style="color: rgba(255,255,255,0.6);">${u.fullName ? u.fullName : '---'}</small>
                                        </div>
                                        <div class="text-end pending-actions">
                                            <button class="btn btn-sm btn-outline-info rounded-circle me-1"
                                                    style="width: 32px; height: 32px; padding: 0;" title="Duyệt tài khoản"
                                                    onclick="approveUser('${u.id}', '${u.username}')">
                                                <i class="fas fa-user-check"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger rounded-circle"
                                                    style="width: 32px; height: 32px; padding: 0;" title="Xóa vĩnh viễn"
                                                    onclick="deleteUser('${u.id}', '${u.username}')">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                `;
                                container.appendChild(card);
                            });
                        } else {
                            // Nếu danh sách trống
                            noMsg.style.display = 'block';
                        }
                    } else {
                        container.innerHTML = `<p class="text-center mt-5" style="color: #ff0032;">Lỗi: ${await response.text()}</p>`;
                    }
                } catch (error) {
                    container.innerHTML = `<p class="text-center mt-5" style="color: #ff0032;"><i class="fas fa-wifi me-2"></i>Mất kết nối máy chủ!</p>`;
                }
            }

            // Code xử lý thêm mới User
            function resetUserModal() {
                document.getElementById('userName').value = '';
                document.getElementById('userPass').value = '';
                document.getElementById('userFullName').value = '';
                document.getElementById('userPhone').value = '';
                document.getElementById('userEmail').value = '';
                document.getElementById('userRole').value = 'STAFF';
                if(typeof hideModalError === "function") hideModalError();
            }

            function resetModal() {
                resetUserModal();
            }

            async function saveUser() {
                if(typeof hideModalError === "function") hideModalError();

                const username = document.getElementById('userName').value.trim();
                const password = document.getElementById('userPass').value.trim();
                const fullName = document.getElementById('userFullName').value.trim();
                const phone = document.getElementById('userPhone').value.trim();
                const email = document.getElementById('userEmail').value.trim();
                const role = document.getElementById('userRole').value;

                if (!username) {
                    if(typeof showModalError === "function") showModalError("Tên đăng nhập không được trống!", "userName");
                    return;
                }
                if (!password) {
                    if(typeof showModalError === "function") showModalError("Vui lòng nhập mật khẩu!", "userPass");
                    return;
                }

                const payload = {
                    username, password, role,
                    fullName: fullName || null,
                    phone: phone || null,
                    email: email || null
                };

                try {
                    const response = await fetch('/users/save', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });

                    if (response.ok) {
                        bootstrap.Modal.getInstance(document.getElementById('crudModal')).hide();
                        if(typeof showSuccessToast === "function") showSuccessToast("Đã tạo tài khoản ACTIVE thành công!");
                        const activePageBtn = document.querySelector('.page-item.active .ajax-page-link');
                        if (activePageBtn) activePageBtn.click(); else reloadTableData('user-data-container');
                    } else {
                        if(typeof showModalError === "function") showModalError(await response.text(), "userName");
                    }
                } catch (error) {
                    if(typeof showModalError === "function") showModalError("Lỗi kết nối máy chủ!", "userName");
                }
            }

            // Xóa User
            function deleteUser(id, username) {
                document.getElementById('deleteTargetId').value = id;
                document.getElementById('deleteTargetName').innerText = username;
                new bootstrap.Modal(document.getElementById('deleteModal')).show();
            }

            async function executeDelete() {
                const id = document.getElementById('deleteTargetId').value;
                try {
                    const response = await fetch(`/users/delete/${id}`, { method: 'DELETE' });
                    if (response.ok) {
                        bootstrap.Modal.getInstance(document.getElementById('deleteModal')).hide();
                        // Ẩn luôn Offcanvas nếu đang mở
                        const offcanvasEl = document.getElementById('pendingOffcanvas');
                        if(offcanvasEl) {
                            const offcanvasInstance = bootstrap.Offcanvas.getInstance(offcanvasEl);
                            if(offcanvasInstance) offcanvasInstance.hide();
                        }
                        if(typeof showSuccessToast === "function") showSuccessToast("Đã thu hồi tài khoản!");
                        const activePageBtn = document.querySelector('.page-item.active .ajax-page-link');
                        if (activePageBtn) activePageBtn.click(); else reloadTableData('user-data-container');
                    } else {
                        alert(await response.text());
                    }
                } catch (error) { console.error(error); }
            }

            // Khóa User
            function lockUser(id, username) {
                document.getElementById('lockTargetId').value = id;
                document.getElementById('lockTargetName').innerText = username;
                new bootstrap.Modal(document.getElementById('lockModal')).show();
            }

            async function executeLock() {
                const id = document.getElementById('lockTargetId').value;
                try {
                    const response = await fetch(`/users/lock/${id}`, { method: 'PUT' });
                    if (response.ok) {
                        bootstrap.Modal.getInstance(document.getElementById('lockModal')).hide();
                        if(typeof showSuccessToast === "function") showSuccessToast("Tài khoản đã bị Vô hiệu hóa!");
                        const activePageBtn = document.querySelector('.page-item.active .ajax-page-link');
                        if (activePageBtn) activePageBtn.click(); else reloadTableData('user-data-container');
                    } else {
                        alert(await response.text());
                    }
                } catch (error) { console.error(error); }
            }

            // Mở Khóa User
            function unlockUser(id, username) {
                document.getElementById('unlockTargetId').value = id;
                document.getElementById('unlockTargetName').innerText = username;
                new bootstrap.Modal(document.getElementById('unlockModal')).show();
            }

            async function executeUnlock() {
                const id = document.getElementById('unlockTargetId').value;
                try {
                    const response = await fetch(`/users/unlock/${id}`, { method: 'PUT' });
                    if (response.ok) {
                        bootstrap.Modal.getInstance(document.getElementById('unlockModal')).hide();
                        if(typeof showSuccessToast === "function") showSuccessToast("Đã ân xá tài khoản thành công!");
                        const activePageBtn = document.querySelector('.page-item.active .ajax-page-link');
                        if (activePageBtn) activePageBtn.click(); else reloadTableData('user-data-container');
                    } else {
                        alert(await response.text());
                    }
                } catch (error) { console.error(error); }
            }

            // Duyệt User
            function approveUser(id, username) {
                document.getElementById('approveTargetId').value = id;
                document.getElementById('approveTargetName').innerText = username;
                new bootstrap.Modal(document.getElementById('approveModal')).show();
            }

            async function executeApprove() {
                const id = document.getElementById('approveTargetId').value;
                try {
                    const response = await fetch(`/users/approve/${id}`, { method: 'PUT' });
                    if (response.ok) {
                        bootstrap.Modal.getInstance(document.getElementById('approveModal')).hide();
                        // Ẩn luôn Offcanvas nếu đang mở
                        const offcanvasEl = document.getElementById('pendingOffcanvas');
                        if(offcanvasEl) {
                            const offcanvasInstance = bootstrap.Offcanvas.getInstance(offcanvasEl);
                            if(offcanvasInstance) offcanvasInstance.hide();
                        }
                        if(typeof showSuccessToast === "function") showSuccessToast("Đã duyệt tài khoản thành công!");
                        const activePageBtn = document.querySelector('.page-item.active .ajax-page-link');
                        if (activePageBtn) activePageBtn.click(); else reloadTableData('user-data-container');
                    } else {
                        alert(await response.text());
                    }
                } catch (error) { console.error(error); }
            }
        </script>
    </main>
</div>
<div th:replace="~{common/scripts :: footer_scripts}"></div>
</body>
</html>
