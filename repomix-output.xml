<file path="FE_JAVA2/FEJAVA2/src/main/resources/templates/customers.html">
<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org" lang="vi">

<head th:replace="~{common/head :: head_info('Khách Hàng - Hệ Thống Quản Lý Kho')}"></head>

<body>
<div id="vanta-canvas"></div>

<div class="container-fluid p-0">
    <nav th:replace="~{common/sidebar :: sidebar_menu('customers')}"></nav>

    <main class="main-content">
        <div th:replace="~{common/styles}"></div>
        <div th:replace="~{common/page-header :: top_header('Cơ Sở Dữ Liệu Khách Hàng', 'Khu Vực Điều Hành')}"></div>

        <div th:replace="~{common/action-bar :: crud_bar('Khách Hàng', 'Tìm tên khách hàng...')}"></div>

        <div id="customer-data-container">
            <div th:replace="~{common/table-card :: ajax_data_grid(
                ~{::table},
                ~{common/pagination-par :: pagination_bar(${currentPage}, ${totalPages}, '/customers', 'customer-data-container')}
            )}">
                <table class="table">
                    <thead>
                    <tr>
                        <th><i class="fas fa-hashtag" style="margin-right: 8px;"></i>STT</th>
                        <th><i class="fas fa-user" style="margin-right: 8px;"></i>Tên Khách Hàng</th>
                        <th><i class="fas fa-phone" style="margin-right: 8px;"></i>Số Điện Thoại</th>
                        <th><i class="fas fa-map-marker-alt" style="margin-right: 8px;"></i>Địa Chỉ</th>
                        <th th:if="${session.ROLE == 'ADMIN'}" class="text-end"><i class="fas fa-cogs" style="margin-right: 8px;"></i>Thao Tác</th>
                    </tr>
                    </thead>
                    <tbody>
                    <tr th:each="c, iterStat : ${list}">
                        <td th:text="${(currentPage * pageSize) + iterStat.count}" style="color: rgba(0, 242, 255, 0.7);"></td>
                        <td th:text="${c.name}" style="color: #e0e0e0; font-weight: 600;"></td>
                        <td class="price-tag" th:text="${c.phone}"></td>
                        <td style="color: #a0a0a0;" th:text="${c.address}"></td>
                        <td th:if="${session.ROLE == 'ADMIN'}" class="text-end">
                            <button class="btn btn-sm btn-outline-info rounded-circle me-1"
                                    style="width: 32px; height: 32px; padding: 0;"
                                    th:data-id="${c.id}"
                                    th:data-name="${c.name}"
                                    th:data-phone="${c.phone}"
                                    th:data-address="${c.address}"
                                    onclick="openEditModal(this.dataset.id, this.dataset.name, this.dataset.phone, this.dataset.address)">
                                <i class="fas fa-pen"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger rounded-circle"
                                    style="width: 32px; height: 32px; padding: 0;"
                                    th:data-id="${c.id}"
                                    th:data-name="${c.name}"
                                    onclick="deleteCustomer(this.dataset.id, this.dataset.name)">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="modal fade" id="crudModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content" style="background: rgba(10, 15, 20, 0.95); backdrop-filter: blur(20px); border: 1px solid #00f2ff; box-shadow: 0 0 30px rgba(0, 242, 255, 0.2);">
                    <div class="modal-header" style="border-bottom: 1px solid rgba(0, 242, 255, 0.2);">
                        <h5 class="modal-title" id="modalTitle" style="color: #00f2ff; font-weight: 600; font-family: 'Poppins', sans-serif;">
                            <i class="fas fa-user-plus me-2"></i>Thêm Khách Hàng Mới
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">
                        <input type="hidden" id="cusId">

                        <div class="mb-3">
                            <label class="form-label" style="color: rgba(255,255,255,0.7); font-size: 0.85rem;">Tên khách hàng (*)</label>
                            <input type="text" id="cusName" class="form-control border-cyber text-white" style="background: rgba(0,0,0,0.5); transition: all 0.3s;" placeholder="Nhập họ và tên...">
                        </div>
                        <div class="mb-3">
                            <label class="form-label" style="color: rgba(255,255,255,0.7); font-size: 0.85rem;">Số điện thoại</label>
                            <input type="text" id="cusPhone" class="form-control border-cyber text-white" style="background: rgba(0,0,0,0.5); transition: all 0.3s;" placeholder="Nhập SĐT...">
                        </div>
                        <div class="mb-3">
                            <label class="form-label" style="color: rgba(255,255,255,0.7); font-size: 0.85rem;">Địa chỉ liên hệ</label>
                            <input type="text" id="cusAddress" class="form-control border-cyber text-white" style="background: rgba(0,0,0,0.5);" placeholder="Nhập địa chỉ...">
                        </div>
                    </div>

                    <div class="modal-footer" style="border-top: 1px solid rgba(0, 242, 255, 0.2);">
                        <button type="button" class="btn btn-cyber btn-cyber-secondary" data-bs-dismiss="modal">Hủy Bỏ</button>
                        <button type="button" class="btn btn-cyber btn-cyber-success" onclick="saveCustomer()">
                            <i class="fas fa-save me-2"></i>Lưu Dữ Liệu
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-sm">
                <div class="modal-content" style="background: rgba(15, 5, 5, 0.95); backdrop-filter: blur(20px); border: 1px solid #ff003c; box-shadow: 0 0 30px rgba(255, 0, 60, 0.2);">
                    <div class="modal-header" style="border-bottom: 1px solid rgba(255, 0, 60, 0.2);">
                        <h5 class="modal-title" style="color: #ff003c; font-weight: 600; font-family: 'Poppins', sans-serif;">
                            <i class="fas fa-exclamation-triangle me-2"></i>Cảnh Báo
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body text-center py-4">
                        <i class="fas fa-trash-alt mb-3" style="font-size: 3rem; color: #ff003c; text-shadow: 0 0 15px rgba(255,0,60,0.6);"></i>
                        <p style="color: #ffffff; font-size: 1rem; margin-bottom: 5px;">Xác nhận xóa khách hàng?</p>
                        <p style="color: #ffffff; opacity: 0.7;">hủy dữ liệu của:</p>
                        <h4 id="deleteTargetName" style="color: #ff003c; font-weight: bold; text-shadow: 0 0 10px rgba(255, 0, 60, 0.5);">---</h4>
                        <p style="color: #ffffff; font-size: 0.8rem; margin-top: 15px; font-style: italic; opacity: 0.5;">* Hành động này không thể hoàn tác.</p>
                        <input type="hidden" id="deleteTargetId">
                    </div>
                    <div class="modal-footer d-flex justify-content-center" style="border-top: 1px solid rgba(255, 0, 60, 0.2);">
                        <button type="button" class="btn btn-cyber btn-cyber-secondary" data-bs-dismiss="modal">Quay Lại</button>
                        <button type="button" class="btn btn-cyber btn-cyber-danger" onclick="executeDelete()">
                            <i class="fas fa-skull me-2"></i>Xác Nhận Xóa
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <script>
            function resetCustomerModal() {
                document.getElementById('modalTitle').innerHTML = '<i class="fas fa-user-plus me-2"></i>Thêm Khách Hàng Mới';
                document.getElementById('cusId').value = '';
                document.getElementById('cusName').value = '';
                document.getElementById('cusPhone').value = '';
                document.getElementById('cusAddress').value = '';
                hideModalError(); // Tự động gọi từ scripts.html
            }

            function resetModal() {
                resetCustomerModal();
            }

            function openEditModal(id, name, phone, address) {
                document.getElementById('modalTitle').innerHTML = '<i class="fas fa-user-edit me-2"></i>Cập Nhật Khách Hàng';
                document.getElementById('cusId').value = id;
                document.getElementById('cusName').value = name;
                document.getElementById('cusPhone').value = (phone === 'null' || !phone) ? '' : phone;
                document.getElementById('cusAddress').value = (address === 'null' || !address) ? '' : address;
                hideModalError();

                var myModal = new bootstrap.Modal(document.getElementById('crudModal'));
                myModal.show();
            }

            async function saveCustomer() {
                hideModalError();

                const id = document.getElementById('cusId').value;
                const name = document.getElementById('cusName').value.trim();
                const phone = document.getElementById('cusPhone').value.trim();
                const address = document.getElementById('cusAddress').value.trim();

                if (!name) {
                    showModalError("Tên khách hàng không được để trống!", "cusName"); // Hàm gọi từ scripts.html
                    return;
                }

                const payload = {
                    id: id ? parseInt(id) : null,
                    name: name,
                    phone: phone,
                    address: address
                };

                try {
                    const response = await fetch('/customers/save', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });

                    if (response.ok) {
                        bootstrap.Modal.getInstance(document.getElementById('crudModal')).hide();
                        showSuccessToast("Đã lưu thông tin khách hàng thành công!"); // Hàm gọi từ scripts.html

                        const activePageBtn = document.querySelector('.page-item.active .ajax-page-link');
                        if (activePageBtn) activePageBtn.click();
                        else reloadTableData('customer-data-container');
                    } else {
                        const errText = await response.text();
                        showModalError(errText, "cusPhone");
                    }
                } catch (error) {
                    showModalError("Không thể kết nối đến máy chủ Frontend!", "cusName");
                }
            }

            function deleteCustomer(id, name) {
                document.getElementById('deleteTargetId').value = id;
                document.getElementById('deleteTargetName').innerText = name;
                var deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
                deleteModal.show();
            }

            async function executeDelete() {
                const id = document.getElementById('deleteTargetId').value;
                try {
                    const response = await fetch(`/customers/delete/${id}`, { method: 'DELETE' });
                    if (response.ok) {
                        bootstrap.Modal.getInstance(document.getElementById('deleteModal')).hide();
                        showSuccessToast("Đã xóa khách hàng khỏi hệ thống!");
                        const activePageBtn = document.querySelector('.page-item.active .ajax-page-link');
                        if (activePageBtn) activePageBtn.click();
                        else reloadTableData('customer-data-container');
                    } else {
                        alert("Xóa thất bại!");
                    }
                } catch (error) {
                    console.error("Lỗi xóa khách hàng:", error);
                }
            }
        </script>
    </main>
</div>

<div th:replace="~{common/scripts :: footer_scripts}"></div>
</body>
</html>
</file>

