                            <span style="color: rgba(255, 255, 255, 0.85); font-size: 0.9rem;">
                                Vui lòng chọn khoảng thời gian và trạng thái tài liệu để tối ưu hóa tệp dữ liệu xuất ra.
                            </span>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label" style="color: #00f2ff; font-size: 0.85rem; font-weight: bold; text-transform: uppercase;">Từ ngày (*)</label>
                                <div class="cyber-search-group">
                                    <input type="date" id="exportStartDate" class="form-control border-cyber text-white" style="background: rgba(0, 0, 0, 0.6); padding-left: 12px;">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" style="color: #00f2ff; font-size: 0.85rem; font-weight: bold; text-transform: uppercase;">Đến ngày (*)</label>
                                <div class="cyber-search-group">
                                    <input type="date" id="exportEndDate" class="form-control border-cyber text-white" style="background: rgba(0, 0, 0, 0.6); padding-left: 12px;">
                                </div>
                            </div>
                            <div class="col-12 mt-3">
                                <label class="form-label" style="color: #00f2ff; font-size: 0.85rem; font-weight: bold; text-transform: uppercase;">Trạng thái chứng từ</label>
                                <select id="exportStatus" class="form-select border-cyber text-white" style="background: rgba(0,0,0,0.6);">
                                    <option value="ALL">Tất Cả Trạng Thái</option>
                                    <option value="COMPLETED">Đã Duyệt (COMPLETED)</option>
                                    <option value="PENDING">Chờ Duyệt (PENDING)</option>
                                    <option value="CANCELLED">Đã Hủy (CANCELLED)</option>
