                    <div class="input-glow"></div>
                </div>
            </div>
            
            <!-- Activity Category Filter (Fully Blue Cyan) -->
            <div class="col-lg-3 col-md-6">
                <div class="cyber-search-group">
                    <i class="fas fa-filter search-icon" style="color: #00f2ff; text-shadow: 0 0 8px rgba(0, 242, 255, 0.8);"></i>
                    <select name="actionType" class="form-select cyber-input" style="padding-left: 45px !important;" onchange="filterAuditLogs(event)">
                        <option value="">-- Tất cả hoạt động --</option>
                        <option value="CREATE_PRODUCT" th:selected="${actionType == 'CREATE_PRODUCT'}">Thêm sản phẩm mới</option>
                        <option value="UPDATE_PRODUCT" th:selected="${actionType == 'UPDATE_PRODUCT'}">Sửa sản phẩm</option>
                        <option value="DELETE_PRODUCT" th:selected="${actionType == 'DELETE_PRODUCT'}">Xóa sản phẩm</option>
                        <option value="CREATE_CUSTOMER" th:selected="${actionType == 'CREATE_CUSTOMER'}">Thêm khách hàng</option>
                        <option value="UPDATE_CUSTOMER" th:selected="${actionType == 'UPDATE_CUSTOMER'}">Sửa khách hàng</option>
                        <option value="DELETE_CUSTOMER" th:selected="${actionType == 'DELETE_CUSTOMER'}">Xóa khách hàng</option>
                        <option value="CREATE_SUPPLIER" th:selected="${actionType == 'CREATE_SUPPLIER'}">Thêm nhà cung cấp</option>
                        <option value="UPDATE_SUPPLIER" th:selected="${actionType == 'UPDATE_SUPPLIER'}">Sửa nhà cung cấp</option>
                        <option value="DELETE_SUPPLIER" th:selected="${actionType == 'DELETE_SUPPLIER'}">Xóa nhà cung cấp</option>
                        <option value="CREATE_STOCK_IN" th:selected="${actionType == 'CREATE_STOCK_IN'}">Lập phiếu nhập kho</option>
                        <option value="APPROVE_STOCK_IN" th:selected="${actionType == 'APPROVE_STOCK_IN'}">Duyệt nhập kho</option>
                        <option value="CANCEL_STOCK_IN" th:selected="${actionType == 'CANCEL_STOCK_IN'}">Hủy phiếu nhập</option>
                        <option value="CREATE_STOCK_OUT" th:selected="${actionType == 'CREATE_STOCK_OUT'}">Lập phiếu xuất kho</option>
                        <option value="APPROVE_STOCK_OUT" th:selected="${actionType == 'APPROVE_STOCK_OUT'}">Duyệt xuất kho</option>
                        <option value="CANCEL_STOCK_OUT" th:selected="${actionType == 'CANCEL_STOCK_OUT'}">Hủy phiếu xuất</option>
                        <option value="CREATE_USER" th:selected="${actionType == 'CREATE_USER'}">Tạo nhân viên mới</option>
                    </select>
                    <div class="input-glow"></div>
                </div>
            </div>
            
            <!-- Date Pickers & Actions (Fully Blue Cyan) -->
            <div class="col-lg-6 col-md-12">
                <div class="row g-2 align-items-center">
                    <div class="col-sm-4">
                        <div class="cyber-search-group">
                            <i class="fas fa-calendar-alt search-icon" style="color: #00f2ff; text-shadow: 0 0 8px rgba(0, 242, 255, 0.8);"></i>
                            <input type="date" name="startDate" th:value="${startDate}" class="form-control cyber-input" style="padding-left: 45px !important;" onchange="filterAuditLogs(event)">
                            <div class="input-glow"></div>
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="cyber-search-group">
                            <i class="fas fa-calendar-alt search-icon" style="color: #00f2ff; text-shadow: 0 0 8px rgba(0, 242, 255, 0.8);"></i>
                            <input type="date" name="endDate" th:value="${endDate}" class="form-control cyber-input" style="padding-left: 45px !important;" onchange="filterAuditLogs(event)">
                            <div class="input-glow"></div>
                        </div>
                    </div>
                    <div class="col-sm-4 d-flex gap-2">
                        <button type="submit" class="btn btn-cyber btn-cyber-outline w-100"><i class="fas fa-filter me-2"></i>Lọc</button>
                        <a href="/audit-logs" class="btn btn-cyber btn-cyber-secondary"><i class="fas fa-sync"></i></a>
