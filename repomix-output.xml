                    </div>
                </div>
            </div>
        </div>

        <script>
            document.addEventListener("DOMContentLoaded", function() {
                const style = document.createElement('style');
                style.innerHTML = `
                    select option { background: rgba(10, 15, 20, 0.95); color: #00f2ff; }
                    .product-thumb:hover { transform: scale(1.15); border-color: #00f2ff !important; box-shadow: 0 0 15px rgba(0, 242, 255, 0.5) !important; }
                `;
                document.head.appendChild(style);
            });

            function showLightbox(src) {
                const lightboxImg = document.getElementById('lightboxImage');
                if (lightboxImg) {
                    lightboxImg.src = src;
                    var lightBox = new bootstrap.Modal(document.getElementById('imageLightboxModal'));
                    lightBox.show();
                }
            }

            function previewImage(event) {
                const file = event.target.files[0];
                const preview = document.getElementById('imagePreview');
                const fileNameDisplay = document.getElementById('fileNameDisplay');
                if (file) {
                    if (fileNameDisplay) fileNameDisplay.innerText = file.name;
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        preview.src = e.target.result;
                        preview.style.display = 'block';
                    }
                    reader.readAsDataURL(file);
                } else {
                    const currentImage = preview.dataset.currentImage;
                    if (fileNameDisplay) {
                        fileNameDisplay.innerText = (currentImage && currentImage !== 'null') ? currentImage : 'Chưa chọn tệp...';
                    }
                    if (currentImage) {
                        preview.src = '/uploads/' + currentImage;
                        preview.style.display = 'block';
                    } else {
                        preview.src = '';
                        preview.style.display = 'none';
                    }
                }
            }

            function resetProductModal() {
                document.getElementById('modalTitle').innerHTML = '<i class="fas fa-plus-circle me-2"></i>Thêm Sản Phẩm Mới';
                document.getElementById('prodId').value = '';
                document.getElementById('prodName').value = '';
                document.getElementById('prodCategory').value = '';
                document.getElementById('prodImport').value = '0';
                document.getElementById('prodExport').value = '0';
                document.getElementById('prodQty').value = '0';
                document.getElementById('prodMinQty').value = '5';
                document.getElementById('prodImage').value = '';
                
                const fileNameDisplay = document.getElementById('fileNameDisplay');
                if (fileNameDisplay) fileNameDisplay.innerText = 'Chưa chọn tệp...';
                
                const preview = document.getElementById('imagePreview');
                preview.src = '';
                preview.style.display = 'none';
                preview.dataset.currentImage = '';
                
                // Ẩn các cột tự động tính toán & cho cột nhập liệu hiển thị full-width
                document.getElementById('autoCalculatedFields').style.display = 'none';
                document.getElementById('mainFieldsColumn').className = 'col-12';
                
                if(typeof hideModalError === "function") hideModalError();
            }

            function resetModal() {
                resetProductModal();
            }

            function openEditModal(id, name, catId, importP, exportP, qty, minQty, imagePath) {
                document.getElementById('modalTitle').innerHTML = '<i class="fas fa-pen me-2"></i>Cập Nhật Sản Phẩm';
                document.getElementById('prodId').value = id;
                document.getElementById('prodName').value = name;
                document.getElementById('prodCategory').value = catId || '';

                // Ép kiểu Number để trị dứt điểm cái mã khoa học 4.5E7
                document.getElementById('prodImport').value = Number(importP);
                document.getElementById('prodExport').value = Number(exportP);

                document.getElementById('prodQty').value = qty;
                document.getElementById('prodMinQty').value = minQty;

                document.getElementById('prodImage').value = '';
                
                const fileNameDisplay = document.getElementById('fileNameDisplay');
                if (fileNameDisplay) {
                    fileNameDisplay.innerText = (imagePath && imagePath !== 'null' && imagePath !== 'undefined' && imagePath.trim() !== '') ? imagePath : 'Chưa chọn tệp...';
                }
                
                const preview = document.getElementById('imagePreview');
                if (imagePath && imagePath !== 'null' && imagePath !== 'undefined' && imagePath.trim() !== '') {
                    preview.src = '/uploads/' + imagePath;
                    preview.style.display = 'block';
                    preview.dataset.currentImage = imagePath;
                } else {
                    preview.src = '';
                    preview.style.display = 'none';
                    preview.dataset.currentImage = '';
                }
                
                // Hiện lại các cột tự động tính toán & đưa cột nhập liệu về lại col-md-6
                document.getElementById('autoCalculatedFields').style.display = 'block';
                document.getElementById('mainFieldsColumn').className = 'col-md-6';
                
                if(typeof hideModalError === "function") hideModalError();

                var myModal = new bootstrap.Modal(document.getElementById('crudModal'));
                myModal.show();
            }

            async function saveProduct() {
                if(typeof hideModalError === "function") hideModalError();

                const id = document.getElementById('prodId').value;
                const name = document.getElementById('prodName').value.trim();
                const categoryId = document.getElementById('prodCategory').value;

                if (!name) {
                    if(typeof showModalError === "function") showModalError("Tên sản phẩm không được để trống!", "prodName");
                    else alert("Tên sản phẩm không được để trống!");
                    return;
                }

                const imageFile = document.getElementById('prodImage').files[0];
                let imagePath = document.getElementById('imagePreview').dataset.currentImage || '';

                if (imageFile) {
                    const formData = new FormData();
                    formData.append('file', imageFile);
                    try {
                        const uploadResponse = await fetch('/products/upload-image', {
                            method: 'POST',
                            body: formData
                        });
                        if (uploadResponse.ok) {
                            imagePath = await uploadResponse.text();
                        } else {
                            const errText = await uploadResponse.text();
                            if(typeof showModalError === "function") showModalError("Lỗi tải ảnh: " + errText, "prodImage");
                            else alert("Lỗi tải ảnh: " + errText);
                            return;
                        }
                    } catch (uploadErr) {
                        if(typeof showModalError === "function") showModalError("Không thể kết nối máy chủ để tải ảnh!", "prodImage");
                        return;
                    }
                }

                const payload = {
                    id: id ? parseInt(id) : null,
                    name: name,
                    categoryId: categoryId ? parseInt(categoryId) : null,
                    importPrice: parseFloat(document.getElementById('prodImport').value) || 0,
                    exportPrice: parseFloat(document.getElementById('prodExport').value) || 0,
                    quantity: parseInt(document.getElementById('prodQty').value) || 0,
                    minQuantity: parseInt(document.getElementById('prodMinQty').value) || 0,
                    imagePath: imagePath
                };

                try {
                    const response = await fetch('/products/save', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });

                    if (response.ok) {
                        bootstrap.Modal.getInstance(document.getElementById('crudModal')).hide();
                        if(typeof showSuccessToast === "function") showSuccessToast("Đã lưu thông tin sản phẩm thành công!");

                        const activePageBtn = document.querySelector('.page-item.active .ajax-page-link');
                        if (activePageBtn) activePageBtn.click();
                        else reloadTableData('product-data-container');
                    } else {
                        const errText = await response.text();
                        if(typeof showModalError === "function") showModalError(errText, "prodName");
                        else alert(errText);
                    }
                } catch (error) {
                    if(typeof showModalError === "function") showModalError("Không thể kết nối máy chủ Frontend!", "prodName");
                }
            }

            function deleteProduct(id, name) {
                document.getElementById('deleteTargetId').value = id;
                document.getElementById('deleteTargetName').innerText = name;
                var deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
                deleteModal.show();
            }

            async function executeDelete() {
                const id = document.getElementById('deleteTargetId').value;
                try {
                    const response = await fetch(`/products/delete/${id}`, { method: 'DELETE' });
                    if (response.ok) {
                        bootstrap.Modal.getInstance(document.getElementById('deleteModal')).hide();
                        if(typeof showSuccessToast === "function") showSuccessToast("Đã xóa sản phẩm thành công!");

                        const activePageBtn = document.querySelector('.page-item.active .ajax-page-link');
                        if (activePageBtn) activePageBtn.click();
                        else reloadTableData('product-data-container');
                    } else {
                        alert("Xóa thất bại!");
                    }
                } catch (error) {
                    console.error(error);
                }
            }
        </script>
    </main>
</div>

<div th:replace="~{common/scripts :: footer_scripts}"></div>
</body>
</html>
