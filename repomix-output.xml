                        <button type="button" class="btn btn-cyber btn-cyber-info" style="background: rgba(0, 242, 255, 0.2); color: #00f2ff; border: 1px solid #00f2ff;" onclick="executeApproveStockOut()"><i class="fas fa-check me-2"></i>Xác Nhận Xuất</button>
                    </div>
                </div>
