    }

    /* PASSWORD STRENGTH COMPONENT */
    .strength-bar-container {
      width: 100%;
      height: 6px;
      background: rgba(255, 255, 255, 0.05) !important;
      border-radius: 3px !important;
      overflow: hidden !important;
    }

    .strength-bar-fill {
      height: 100% !important;
