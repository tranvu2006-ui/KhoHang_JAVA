      background: rgba(0, 242, 255, 0.15) !important;
      border: 1px solid var(--cyber-blue) !important;
      color: var(--cyber-blue) !important;
    }

    .strength-hints small {
      font-size: 0.75rem !important;
      transition: color 0.3s ease !important;
    }

    .strength-hints small.valid {
      color: var(--cyber-green) !important;
    }

    .strength-hints small.valid i {
      color: var(--cyber-green) !important;
    }
    </style>

    <!-- JS TỰ CHẠY (Được SPA tự động chạy vì nằm bên trong main-content) -->
    <script>
    // PASSWORD STRENGTH ANALYZER
    function analyzePasswordStrength(password) {
      const bar = document.getElementById('strength-bar');
      const label = document.getElementById('strength-label');
      
      const hLen = document.getElementById('hint-len');
      const hNum = document.getElementById('hint-num');
      const hSpec = document.getElementById('hint-spec');

      const isLenValid = password.length >= 6;
      const isNumValid = /[0-9]/.test(password);
      const isSpecValid = /[^A-Za-z0-9]/.test(password);

      toggleHintStyle(hLen, isLenValid);
      toggleHintStyle(hNum, isNumValid);
      toggleHintStyle(hSpec, isSpecValid);

      let score = 0;
      if (password.length > 0) {
        if (isLenValid) score++;
        if (isNumValid) score++;
        if (isSpecValid) score++;
      }

      bar.className = 'strength-bar-fill';
      label.className = 'badge-cyber';

      if (score === 0) {
        bar.style.width = '0%';
        label.innerText = 'Chưa Nhập';
        label.classList.add('badge-strength-none');
      } else if (score === 1) {
        bar.classList.add('strength-weak');
        label.innerText = 'Yếu';
        label.classList.add('badge-strength-weak');
      } else if (score === 2) {
        bar.classList.add('strength-medium');
        label.innerText = 'Trung Bình';
        label.classList.add('badge-strength-medium');
      } else if (score === 3) {
        bar.classList.add('strength-strong');
        label.innerText = 'Mạnh';
        label.classList.add('badge-strength-strong');
      }
    }

    function toggleHintStyle(element, isValid) {
      if (isValid) {
        element.classList.add('valid');
        element.classList.remove('text-muted-cyber');
        element.querySelector('i').className = 'fas fa-check-circle me-1';
      } else {
        element.classList.remove('valid');
        element.classList.add('text-muted-cyber');
        element.querySelector('i').className = 'far fa-circle me-1';
      }
    }

    // CHANGE PASSWORD HANDLER
    async function handleChangePassword(e) {
      e.preventDefault();
      
      const oldPassword = document.getElementById('oldPassword').value;
      const newPassword = document.getElementById('newPassword').value;
      const confirmPassword = document.getElementById('confirmPassword').value;

      if (newPassword !== confirmPassword) {
        showCyberAlert('Xác nhận mật khẩu mới không khớp!', 'error');
        return;
      }

      if (newPassword.length < 6) {
        showCyberAlert('Mật khẩu mới tối thiểu 6 ký tự!', 'error');
        return;
      }

      const payload = { oldPassword, newPassword };

      try {
        const res = await fetch('/profile/change-password', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        if (res.ok) {
          showCyberAlert('Đổi mật khẩu thành công!', 'success');
          document.getElementById('passwordForm').reset();
          analyzePasswordStrength('');
        } else {
          const errMsg = await res.text();
          showCyberAlert(errMsg || 'Đổi mật khẩu thất bại!', 'error');
        }
      } catch (error) {
        showCyberAlert('Lỗi kết nối máy chủ!', 'error');
      }
    }
    </script>
  </main>
</div>

