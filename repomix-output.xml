        </div>

        <div class="modal fade" id="cancelStockOutModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-sm">
                <div class="modal-content" style="background: rgba(15, 5, 5, 0.95); border: 1px solid #ff003c;">
                    <div class="modal-header" style="border-bottom: 1px solid rgba(255, 0, 60, 0.2);">
                        <h5 class="modal-title" style="color: #ff003c; font-weight: 600;"><i class="fas fa-skull-crossbones me-2"></i>Hủy Phiếu</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body text-center py-4">
                        <i class="fas fa-trash-alt mb-3" style="font-size: 3rem; color: #ff003c;"></i>
                        <p style="color: #ffffff;">Xác nhận hủy bỏ chứng từ xuất kho:</p>
                        <h4 id="cancelOutTargetName" style="color: #ff003c; font-weight: bold;">---</h4>
                        <input type="hidden" id="cancelOutTargetId">
                    </div>
                    <div class="modal-footer d-flex justify-content-center" style="border-top: 1px solid rgba(255, 0, 60, 0.2);">
                        <button type="button" class="btn btn-cyber btn-cyber-secondary" data-bs-dismiss="modal">Bỏ qua</button>
                        <button type="button" class="btn btn-cyber btn-cyber-danger" onclick="executeCancelStockOut()"><i class="fas fa-times me-2"></i>Hủy Phiếu</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cyberpunk Export Excel Configuration Modal -->
        <div class="modal fade" id="exportExcelModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-md">
                <div class="modal-content" style="background: rgba(10, 15, 20, 0.95); backdrop-filter: blur(20px); border: 1px solid #00f2ff; box-shadow: 0 0 20px rgba(0, 242, 255, 0.25);">
                    <div class="modal-header" style="border-bottom: 1px solid rgba(0, 242, 255, 0.2);">
                        <h5 class="modal-title" style="color: #00f2ff; font-weight: 600;">
                            <i class="fas fa-file-export me-2"></i>CẤU HÌNH XUẤT FILE EXCEL
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body">
                        <div class="p-3 mb-3 text-center" style="background: rgba(0, 242, 255, 0.05); border: 1px dashed rgba(0, 242, 255, 0.3); border-radius: 8px;">
