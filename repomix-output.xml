<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org" lang="vi">

<head th:replace="~{common/head :: head_info('Biểu Đồ - Hệ Thống Quản Lý Kho')}"></head>

<body>
<div id="vanta-canvas"></div>

<div class="container-fluid p-0">

  <nav th:replace="~{common/sidebar :: sidebar_menu('dashboard')}"></nav>

  <main class="main-content">

    <div th:replace="~{common/styles}"></div>

    <div th:replace="~{common/page-header :: top_header('Biểu Đồ Tổng Quan', 'Hệ Thống Trung Tâm')}"></div>

    <!-- 🌟 HÀNG 1: 4 THẺ CHỈ SỐ NHANH KPI (GLASSMORPHISM NEON) -->
    <div class="row g-4 mb-4">
      <!-- Card 1: Tổng dòng sản phẩm -->
      <div class="col-md-3">
        <div class="cyber-table-card p-3 d-flex align-items-center justify-content-between" style="border-left: 4px solid var(--cyber-blue); box-shadow: 0 0 15px rgba(0, 242, 255, 0.15);">
