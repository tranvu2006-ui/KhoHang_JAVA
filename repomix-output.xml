<file path="FE_JAVA2/FEJAVA2/src/main/resources/templates/audit-log.html">
<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org" lang="vi">

<head th:replace="~{common/head :: head_info('Nhật Ký Hoạt Động - Hệ Thống Quản Lý Kho')}"></head>

<body>
<div id="vanta-canvas"></div>

<div class="container-fluid p-0">
    <nav th:replace="~{common/sidebar :: sidebar_menu('audit-logs')}"></nav>

    <main class="main-content">
        <div th:replace="~{common/styles}"></div>
        <div th:replace="~{common/page-header :: top_header('Nhật Ký Hoạt Động', 'Lịch Sử Thao Tác Hệ Thống')}"></div>

        <!-- Cyberpunk Action & Filter Bar (Standardized in action-bar.html) -->
        <div th:replace="~{common/action-bar :: audit_bar()}"></div>

        <!-- Cyberpunk Data Table Container (Standardized structure mirroring products.html, IP column removed, original activity badge colors kept) -->
        <div id="audit-log-data-container">
            <div th:replace="~{common/table-card :: ajax_data_grid(
                ~{::table},
                ~{common/pagination-par :: pagination_bar(${currentPage}, ${totalPages}, '/audit-logs', 'audit-log-data-container')}
            )}">
                <table class="table">
                    <thead>
                    <tr>
                        <th style="width: 80px;"><i class="fas fa-hashtag" style="margin-right: 8px;"></i>STT</th>
                        <th style="width: 180px;"><i class="fas fa-calendar-alt" style="margin-right: 8px;"></i>Thời Gian</th>
                        <th style="width: 150px;"><i class="fas fa-user-circle" style="margin-right: 8px;"></i>Tài Khoản</th>
                        <th style="width: 180px;"><i class="fas fa-id-card" style="margin-right: 8px;"></i>Họ Tên</th>
                        <th style="width: 180px;"><i class="fas fa-info-circle" style="margin-right: 8px;"></i>Hoạt Động</th>
                        <th><i class="fas fa-file-alt" style="margin-right: 8px;"></i>Nội Dung Mô Tả</th>
                    </tr>
                    </thead>
                    <tbody>
                    <tr th:each="log, iterStat : ${list}">
                        <td style="color: rgba(0, 242, 255, 0.7);" th:text="${(currentPage * pageSize) + iterStat.count}"></td>
                        
                        <td style="color: #e0e0e0;" 
                            th:text="${log.createdAt != null ? #strings.substring(log.createdAt,8,10) + '/' + #strings.substring(log.createdAt,5,7) + '/' + #strings.substring(log.createdAt,0,4) + ' ' + #strings.substring(log.createdAt,11,19) : '---'}">
                        </td>
                        
                        <td style="color: #ffffff; font-weight: 500;" th:text="${log.username}"></td>
                        
                        <td style="color: #a0a0a0;" th:text="${log.userId != null and userFullNameMap != null and userFullNameMap.containsKey(#strings.toString(log.userId)) ? userFullNameMap[#strings.toString(log.userId)] : '---'}"></td>
                        
                        <td>
                            <!-- Original colored activity badges kept for maximum status distinction -->
                            <span th:if="${log.actionType.startsWith('APPROVE')}" class="badge bg-success" style="font-size: 0.75rem;">
                                <i class="fas fa-check-double me-1"></i>Duyệt Phiếu
                            </span>
                            <span th:if="${log.actionType.startsWith('CANCEL') or log.actionType.startsWith('DELETE')}" class="badge bg-danger" style="font-size: 0.75rem;">
                                <i class="fas fa-ban me-1"></i>Hủy/Xóa
                            </span>
                            <span th:if="${log.actionType.startsWith('CREATE') and log.actionType != 'CREATE_USER'}" class="badge bg-info text-dark" style="font-size: 0.75rem;">
                                <i class="fas fa-plus-circle me-1"></i>Tạo Mới
                            </span>
                            <span th:if="${log.actionType.startsWith('UPDATE')}" class="badge bg-primary" style="font-size: 0.75rem;">
                                <i class="fas fa-pen me-1"></i>Chỉnh Sửa
                            </span>
                            <span th:if="${log.actionType == 'CREATE_USER'}" class="badge bg-warning text-dark" style="font-size: 0.75rem;">
                                <i class="fas fa-user-shield me-1"></i>Tài Khoản
                            </span>
                            <span th:if="${!log.actionType.startsWith('APPROVE') and !log.actionType.startsWith('CANCEL') and !log.actionType.startsWith('DELETE') and !log.actionType.startsWith('CREATE') and !log.actionType.startsWith('UPDATE')}" class="badge bg-secondary" style="font-size: 0.75rem;">
                                <i class="fas fa-tasks me-1"></i>Hoạt Động
                            </span>
                        </td>
                        
                        <td style="color: #ffffff; font-weight: 400;" th:text="${log.description}"></td>
                    </tr>
                    <tr th:if="${#lists.isEmpty(list)}">
                        <td colspan="6" class="text-center py-4" style="color: rgba(255,255,255,0.4); font-style: italic;">
                            <i class="fas fa-inbox me-2" style="font-size: 1.5rem; color: rgba(0, 242, 255, 0.4);"></i> Không tìm thấy lịch sử hoạt động nào phù hợp.
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <script>
            // Thiết lập màu nền và chữ tùy chỉnh cho các tùy chọn select (Theme Cyber)
            document.addEventListener("DOMContentLoaded", function() {
                const style = document.createElement('style');
                style.innerHTML = `select option { background: rgba(10, 15, 20, 0.98); color: #00f2ff; }`;
                document.head.appendChild(style);
            });

            // Bộ lọc AJAX đa năng cực nhạy
            function filterAuditLogs(e) {
                if (e) e.preventDefault();
                const form = document.getElementById("filterForm");
                const keyword = form.keyword.value;
                const actionType = form.actionType.value;
                const startDate = form.startDate.value;
                const endDate = form.endDate.value;
                
                const url = `/audit-logs?keyword=${encodeURIComponent(keyword)}&actionType=${encodeURIComponent(actionType)}&startDate=${encodeURIComponent(startDate)}&endDate=${encodeURIComponent(endDate)}&page=0`;
                
                // Cập nhật thanh địa chỉ trình duyệt
                window.history.pushState({}, '', url);
                
                // Gửi request XMLHttp
                fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(response => response.text())
                    .then(html => {
                        const container = document.getElementById('audit-log-data-container');
                        if (container) {
                            container.outerHTML = html;
                        }
                    })
                    .catch(err => console.error('Lỗi khi lọc lịch sử hoạt động:', err));
            }

            // Debounce hỗ trợ tìm kiếm khi nhập ký tự
            let localSearchTimeout = null;
            function debounceFilterAuditLogs() {
                clearTimeout(localSearchTimeout);
                localSearchTimeout = setTimeout(() => {
                    filterAuditLogs();
                }, 450);
            }
        </script>
    </main>
</div>

<div th:replace="~{common/scripts :: footer_scripts}"></div>
</body>
</html>
</file>

<file path="FE_JAVA2/FEJAVA2/src/main/resources/templates/categories.html">
<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org" lang="vi">

<head th:replace="~{common/head :: head_info('Danh Mục - Hệ Thống Quản Lý Kho')}"></head>

<body>
<div id="vanta-canvas"></div>

<div class="container-fluid p-0">
    <nav th:replace="~{common/sidebar :: sidebar_menu('categories')}"></nav>

    <main class="main-content">
        <div th:replace="~{common/styles}"></div>
        <div th:replace="~{common/page-header :: top_header('Quản Lý Danh Mục', 'Phân Loại Sản Phẩm')}"></div>

        <div th:replace="~{common/action-bar :: crud_bar('Danh Mục', 'Tìm tên danh mục...')}"></div>

        <div id="category-data-container">
            <div th:replace="~{common/table-card :: ajax_data_grid(
                ~{::table},
                ~{common/pagination-par :: pagination_bar(${currentPage}, ${totalPages}, '/categories', 'category-data-container')}
            )}">
                <table class="table">
                    <thead>
                    <tr>
                        <th style="width: 10%;"><i class="fas fa-hashtag" style="margin-right: 8px;"></i>STT</th>
                        <th><i class="fas fa-tags" style="margin-right: 8px;"></i>Tên Danh Mục</th>
                        <th th:if="${session.ROLE == 'ADMIN'}" class="text-end" style="width: 20%;"><i class="fas fa-cogs" style="margin-right: 8px;"></i>Thao Tác</th>
                    </tr>
                    </thead>
                    <tbody>
                    <tr th:each="c, iterStat : ${list}">
                        <td th:text="${(currentPage * pageSize) + iterStat.count}" style="color: rgba(0, 242, 255, 0.7);"></td>
                        <td>
                            <span class="badge" style="background: rgba(112, 0, 255, 0.2); color: #b366ff; border: 1px solid rgba(112, 0, 255, 0.4); font-size: 0.95rem; padding: 8px 15px;" th:text="${c.name}"></span>
                        </td>
                        <td th:if="${session.ROLE == 'ADMIN'}" class="text-end">
                            <button class="btn btn-sm btn-outline-info rounded-circle me-1"
                                    style="width: 32px; height: 32px; padding: 0;"
                                    th:data-id="${c.id}"
                                    th:data-name="${c.name}"
                                    onclick="openEditModal(this.dataset.id, this.dataset.name)">
                                <i class="fas fa-pen"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger rounded-circle"
                                    style="width: 32px; height: 32px; padding: 0;"
                                    th:data-id="${c.id}"
                                    th:data-name="${c.name}"
                                    onclick="deleteCategory(this.dataset.id, this.dataset.name)">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="modal fade" id="crudModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-sm">
                <div class="modal-content" style="background: rgba(10, 15, 20, 0.95); backdrop-filter: blur(20px); border: 1px solid #00f2ff; box-shadow: 0 0 30px rgba(0, 242, 255, 0.2);">
                    <div class="modal-header" style="border-bottom: 1px solid rgba(0, 242, 255, 0.2);">
                        <h5 class="modal-title" id="modalTitle" style="color: #00f2ff; font-weight: 600;"><i class="fas fa-plus-circle me-2"></i>Thêm Danh Mục</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="catId">
                        <div class="mb-2">
                            <label class="form-label" style="color: rgba(255,255,255,0.7); font-size: 0.85rem;">Tên danh mục (*)</label>
                            <input type="text" id="catName" class="form-control border-cyber text-white" style="background: rgba(0,0,0,0.5); transition: all 0.3s;" placeholder="Ví dụ: Phụ kiện...">
                        </div>
                    </div>
                    <div class="modal-footer" style="border-top: 1px solid rgba(0, 242, 255, 0.2);">
                        <button type="button" class="btn btn-cyber btn-cyber-secondary" data-bs-dismiss="modal">Hủy</button>
                        <button type="button" class="btn btn-cyber btn-cyber-success" onclick="saveCategory()"><i class="fas fa-save me-2"></i>Lưu</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-sm">
                <div class="modal-content" style="background: rgba(15, 5, 5, 0.95); backdrop-filter: blur(20px); border: 1px solid #ff003c; box-shadow: 0 0 30px rgba(255, 0, 60, 0.2);">
                    <div class="modal-header" style="border-bottom: 1px solid rgba(255, 0, 60, 0.2);">
                        <h5 class="modal-title" style="color: #ff003c; font-weight: 600;"><i class="fas fa-exclamation-triangle me-2"></i>Cảnh Báo</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body text-center py-4">
                        <i class="fas fa-trash-alt mb-3" style="font-size: 3rem; color: #ff003c; text-shadow: 0 0 15px rgba(255,0,60,0.6);"></i>
                        <p style="color: #ffffff; font-size: 1rem;">Xóa danh mục này?</p>
                        <h4 id="deleteTargetName" style="color: #ff003c; font-weight: bold;">---</h4>
                        <input type="hidden" id="deleteTargetId">
                    </div>
                    <div class="modal-footer d-flex justify-content-center" style="border-top: 1px solid rgba(255, 0, 60, 0.2);">
                        <button type="button" class="btn btn-cyber btn-cyber-secondary" data-bs-dismiss="modal">Hủy</button>
                        <button type="button" class="btn btn-cyber btn-cyber-danger" onclick="executeDelete()">Xóa</button>
                    </div>
                </div>
            </div>
        </div>

        <script>
            function resetCategoryModal() {
                document.getElementById('modalTitle').innerHTML = '<i class="fas fa-plus-circle me-2"></i>Thêm Danh Mục';
                document.getElementById('catId').value = '';
                document.getElementById('catName').value = '';
                if(typeof hideModalError === "function") hideModalError();
            }

            function resetModal() {
                resetCategoryModal();
            }

            function openEditModal(id, name) {
                document.getElementById('modalTitle').innerHTML = '<i class="fas fa-pen me-2"></i>Sửa Danh Mục';
                document.getElementById('catId').value = id;
                document.getElementById('catName').value = name;
                if(typeof hideModalError === "function") hideModalError();
                new bootstrap.Modal(document.getElementById('crudModal')).show();
            }

            async function saveCategory() {
                if(typeof hideModalError === "function") hideModalError();

                const id = document.getElementById('catId').value;
                const name = document.getElementById('catName').value.trim();

                if (!name) {
                    if(typeof showModalError === "function") showModalError("Vui lòng nhập tên danh mục!", "catName");
                    return;
                }

                const payload = { id: id ? parseInt(id) : null, name: name };

                try {
                    const response = await fetch('/categories/save', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });

                    if (response.ok) {
                        bootstrap.Modal.getInstance(document.getElementById('crudModal')).hide();
                        if(typeof showSuccessToast === "function") showSuccessToast("Đã lưu danh mục!");
                        const activePageBtn = document.querySelector('.page-item.active .ajax-page-link');
                        if (activePageBtn) activePageBtn.click(); else reloadTableData('category-data-container');
                    } else {
                        const errText = await response.text();
                        if(typeof showModalError === "function") showModalError(errText, "catName");
                    }
                } catch (error) {
                    if(typeof showModalError === "function") showModalError("Lỗi kết nối máy chủ!", "catName");
                }
            }

            function deleteCategory(id, name) {
                document.getElementById('deleteTargetId').value = id;
                document.getElementById('deleteTargetName').innerText = name;
                new bootstrap.Modal(document.getElementById('deleteModal')).show();
            }

            async function executeDelete() {
                const id = document.getElementById('deleteTargetId').value;
                try {
                    const response = await fetch(`/categories/delete/${id}`, { method: 'DELETE' });
                    if (response.ok) {
                        bootstrap.Modal.getInstance(document.getElementById('deleteModal')).hide();
                        if(typeof showSuccessToast === "function") showSuccessToast("Đã xóa danh mục!");
                        const activePageBtn = document.querySelector('.page-item.active .ajax-page-link');
                        if (activePageBtn) activePageBtn.click(); else reloadTableData('category-data-container');
                    } else {
                        alert(await response.text());
                    }
                } catch (error) { console.error(error); }
            }
        </script>
    </main>
</div>

<div th:replace="~{common/scripts :: footer_scripts}"></div>
</body>
</html>
</file>

<file path="FE_JAVA2/FEJAVA2/src/main/resources/templates/common/action-bar.html">
<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<body>

<!-- Standard CRUD Action Bar for Product, Stock In, Stock Out, etc. -->
<div th:fragment="crud_bar(pageType, placeholderText)" class="action-bar-container mb-4">
    <div class="row align-items-center g-3">

        <div class="col-md-5 col-lg-4">
            <div class="cyber-search-group">
                <i class="fas fa-search search-icon"></i>
                <input type="text"
                       class="form-control cyber-input search-input"
                       th:placeholder="${placeholderText}"
                       th:value="${keyword}">
                <div class="input-glow"></div>
            </div>
        </div>

        <div class="col-md-7 col-lg-8 text-md-end">
            <div class="d-flex flex-wrap gap-2 justify-content-md-end">

                <button th:if="${pageType == 'Tài Khoản'}"
                        class="btn btn-cyber btn-cyber-info"
                        onclick="openPendingPanel()">
                    <i class="fas fa-user-clock me-2"></i>Chờ Duyệt
                </button>

                <button th:if="${session.ROLE == 'ADMIN' and pageType == 'Phiếu Nhập'}"
                        class="btn btn-cyber btn-cyber-warning"
                        onclick="openPendingStockInPanel()">
                    <i class="fas fa-file-signature me-2"></i>Chờ Duyệt
                </button>

                <button th:if="${session.ROLE == 'ADMIN' and pageType == 'Phiếu Xuất'}"
                        class="btn btn-cyber btn-cyber-warning"
                        onclick="openPendingStockOutPanel()">
                    <i class="fas fa-hourglass-half me-2"></i>Chờ Duyệt
                </button>

                <button th:if="${session.ROLE == 'ADMIN' or (pageType != 'Sản Phẩm' and pageType != 'Khách Hàng' and pageType != 'Nhà Cung Cấp' and pageType != 'Danh Mục')}"
                        class="btn btn-cyber btn-cyber-success"
                        data-bs-toggle="modal"
                        data-bs-target="#crudModal"
                        onclick="resetModal()">
                    <i class="fas fa-plus-circle me-2"></i>Thêm <span th:text="${pageType}"></span>
                </button>

                <button th:if="${pageType == 'Phiếu Nhập' || pageType == 'Phiếu Xuất'}"
                        class="btn btn-cyber btn-cyber-outline"
                        data-bs-toggle="modal"
                        data-bs-target="#exportExcelModal">
                    <i class="fas fa-file-export me-2"></i>Xuất Excel
                </button>

                <button th:if="${pageType != 'Phiếu Nhập' && pageType != 'Phiếu Xuất'}"
                        class="btn btn-cyber btn-cyber-outline"
                        th:data-pagetype="${pageType}"
                        onclick="triggerDirectExcelExport(this)">
                    <i class="fas fa-file-export me-2"></i>Xuất Excel
                </button>

                <button class="btn btn-cyber btn-cyber-secondary" onclick="window.location.reload()">
                    <i class="fas fa-sync-alt"></i>
                </button>
            </div>
        </div>

    </div>
    <script th:inline="javascript">
        function triggerDirectExcelExport(btn) {
            const pageType = btn.getAttribute('data-pagetype');
            let endpoint = '';
            if (pageType === 'Sản Phẩm') endpoint = 'products';
            else if (pageType === 'Danh Mục') endpoint = 'categories';
            else if (pageType === 'Khách Hàng') endpoint = 'customers';
            else if (pageType === 'Nhà Cung Cấp') endpoint = 'suppliers';
            else if (pageType === 'Tài Khoản') endpoint = 'users';

            if (!endpoint) {
                if (typeof showCyberAlert === 'function') {
                    showCyberAlert('Trang này chưa được hỗ trợ xuất Excel!', 'warning');
                } else {
                    alert('Trang này chưa được hỗ trợ xuất Excel!');
                }
                return;
            }

            const originalHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Đang xuất...';

            setTimeout(() => {
                window.location.href = '/api/export/' + endpoint;
                
                // Trả lại trạng thái bình thường sau 1.5s
                setTimeout(() => {
                    btn.disabled = false;
                    btn.innerHTML = originalHtml;
                    if (typeof showCyberAlert === 'function') {
                        showCyberAlert('Báo cáo Excel đang được tải xuống!', 'success');
                    }
                }, 1000);
            }, 500);
        }
    </script>
</div>

<!-- Standard Audit Log Action & Filter Bar (Fully Blue Cyan Theme) -->
<div th:fragment="audit_bar()" class="action-bar-container mb-4" style="background: rgba(10, 15, 25, 0.85); backdrop-filter: blur(15px); border: 1px solid rgba(0, 242, 255, 0.2); box-shadow: 0 0 15px rgba(0, 242, 255, 0.05); border-radius: 16px; padding: 1.2rem;">
    <form id="filterForm" onsubmit="filterAuditLogs(event)">
        <div class="row align-items-center g-3">
            
            <!-- Search Box (Standard Blue Cyan) -->
            <div class="col-lg-3 col-md-6">
                <div class="cyber-search-group">
                    <i class="fas fa-search search-icon" style="color: #00f2ff; text-shadow: 0 0 8px rgba(0, 242, 255, 0.8);"></i>
                    <input type="text"
                           name="keyword"
                           class="form-control cyber-input"
                           placeholder="Tìm nhân viên, mô tả..."
