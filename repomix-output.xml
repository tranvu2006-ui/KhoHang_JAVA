<file path="FE_JAVA2/FEJAVA2/src/main/resources/templates/common/styles.html">
<style>
    :root {
        --cyber-blue: #00f2ff;
        --cyber-purple: #7000ff;
        --cyber-cyan: #0ff;
        --cyber-dark: #050505;
        --cyber-border: rgba(0, 242, 255, 0.3);

    }
    body{
        background: radial-gradient(circle at 20% 50%, rgba(0, 242, 255, 0.1) 0%, transparent 50%);
    }
    .user-greeting small {
        color: rgba(255, 255, 255, 0.7);
        font-style: italic;
        font-size: 0.9rem;
    }
    /* =========================================
       1. CYBER TABLE CARD (Khung nền bảng)
       ========================================= */
    .cyber-table-card {
        background: #000000;
        backdrop-filter: blur(20px);
        border: 1px solid rgba(0, 242, 255, 0.2);
        border-radius: 15px;
        padding: 1.5rem;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.8), inset 0 0 20px rgba(0, 242, 255, 0.05);
        position: relative;
        margin-bottom: 2rem;
    }


    /* =========================================
       2. TABLE STYLING (Giao diện Bảng dữ liệu)
       ========================================= */
    .table {
        color: rgba(255, 255, 255, 0.85);
        background: transparent;
        position: relative;
        z-index: 2;
        margin-bottom: 0;
        vertical-align: middle;
    }

    .table > :not(caption) > * > * {
        background-color: transparent;
        border-bottom: 1px solid rgba(0, 242, 255, 0.1);
    }

    .table thead th {
        color: var(--cyber-blue);
        text-transform: uppercase;
        font-size: 0.85rem;
        font-weight: 700;
        border-bottom: 2px solid rgba(0, 242, 255, 0.3);
        letter-spacing: 1px;
        white-space: nowrap;
    }

    .table tbody tr {
        transition: all 0.3s ease;
    }

    .table tbody tr:hover td {
        background: rgba(0, 242, 255, 0.12);
        box-shadow: inset 0 0 20px rgba(0, 242, 255, 0.08);
    }

    /* =========================================
       3. TAGS & BADGES (Các loại nhãn, trạng thái)
       ========================================= */
    .price-tag {
        color: #00f2ff !important;
        font-family: 'Courier New', Courier, monospace;
        font-weight: bold;
        text-shadow: 0 0 8px rgba(0, 242, 255, 0.5);
    }

    .qty-tag {
        color: white !important;
        background: rgba(255, 255, 255, 0.1);
        padding: 4px 10px;
        border-radius: 4px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        font-family: 'Courier New', Courier, monospace;
    }

    .badge {
        padding: 0.5rem 0.75rem;
        font-weight: 600;
        border-radius: 8px;
        letter-spacing: 1px;
        transition: all 0.3s ease;
    }

    .badge.bg-success {
        background: rgba(34, 197, 94, 0.2) !important;
        color: #22c55e !important;
        border-color: rgba(34, 197, 94, 0.4) !important;
        text-shadow: 0 0 5px rgba(34, 197, 94, 0.3);
    }

    .badge.bg-danger {
        background: rgba(239, 68, 68, 0.2) !important;
        color: #ef4444 !important;
        border-color: rgba(239, 68, 68, 0.4) !important;
        text-shadow: 0 0 5px rgba(239, 68, 68, 0.3);
    }

    .role-admin {
        background: rgba(239, 68, 68, 0.15);
        color: #ef4444;
        border: 1px solid rgba(239, 68, 68, 0.4);
    }

    .role-user {
        background: rgba(0, 242, 255, 0.15);
        color: #00f2ff;
        border: 1px solid rgba(0, 242, 255, 0.4);
    }

    .badge:hover {
        transform: translateY(-2px);
        box-shadow: 0 0 15px currentColor;
    }

    /* =========================================
       4. CYBER BUTTONS (Nút bấm action bar)
       ========================================= */
    .btn-cyber {
        border-radius: 8px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        padding: 0.6rem 1.2rem;
        transition: all 0.3s ease;
        border: 1px solid transparent;
    }

    .btn-cyber-success {
        background: rgba(34, 197, 94, 0.2);
        color: #22c55e;
        border-color: rgba(34, 197, 94, 0.4);
    }

    .btn-cyber-success:hover {
        background: #22c55e;
        color: #000;
        box-shadow: 0 0 20px rgba(34, 197, 94, 0.6);
    }

    .btn-cyber-outline {
        background: transparent;
        color: var(--cyber-blue);
        border-color: var(--cyber-blue);
    }

    .btn-cyber-outline:hover {
        background: var(--cyber-blue);
        color: #000;
        box-shadow: 0 0 20px rgba(0, 242, 255, 0.6);
    }

    .btn-cyber-secondary {
        background: rgba(255, 255, 255, 0.1);
        color: #fff;
        border-color: rgba(255, 255, 255, 0.2);
    }

    /* =========================================
       5. CYBER SEARCH INPUT (ĐÃ FIX LỖI 4 GÓC)
       ========================================= */

    .cyber-search-group {
        position: relative;
        display: flex;
        align-items: center;
        border-radius: 10px; /* Độ bo góc ngoài */
        background: rgba(0, 242, 255, 0.3); /* Màu viền tĩnh */
        overflow: hidden; /* Cắt xén viền tràn */
        transition: box-shadow 0.3s ease;
    }

    .cyber-search-group:focus-within {
        box-shadow: 0 0 15px rgba(0, 242, 255, 0.4);
    }

    .cyber-input {
        margin: 2px; /* Khe hở 2px tạo thành độ dày của viền */
        border-radius: 8px !important; /* Độ bo góc trong */
        background: #050505 !important;
        border: none !important;
        color: #00f2ff !important;
        padding-left: 45px !important;
        height: 45px;
        width: 100%;
        z-index: 2; /* Nằm đè lên khối sáng để làm mặt nạ che ruột */
        box-shadow: none !important;
        outline: none !important;
    }

    .cyber-input::placeholder {
        color: rgba(0, 242, 255, 0.5) !important;
        font-style: italic;
        font-size: 0.9rem;
        letter-spacing: 1px;
    }

    .search-icon {
        position: absolute;
        left: 17px;
        color: #00f2ff;
        font-size: 1.1rem;
        z-index: 5;
        text-shadow: 0 0 8px rgba(0, 242, 255, 0.8);
    }

    /* --- BẢN FIX .input-glow --- */
    .input-glow {
        position: absolute;
        bottom: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 0;
        height: 2px; /* Bắt đầu với tia sáng 2px ở đáy */

        /* Dùng khối nền đặc thay vì border trong suốt */
        background: #00f2ff;
        border-radius: 10px; /* Ép bo góc chuẩn theo group ngoài */
        z-index: 1; /* Nằm dưới ô input đen */
        pointer-events: none;

        /* Lúc nhả click: Rút chiều cao (0.2s) -> Rút chiều rộng (0.2s) */
        transition: height 0.2s ease 0s, width 0.2s ease 0.2s;
    }

    /* --- KHI FOCUS (BẤM VÀO Ô TÌM KIẾM) --- */
    .cyber-input:focus ~ .input-glow {
        width: 100%;
        height: 100%; /* Sáng bùng lên full box */

        /* Mở rộng đáy từ giữa ra 2 bên (0.2s) -> Dâng cao lên đỉnh (0.2s) */
        transition: width 0.2s ease 0s, height 0.2s ease 0.2s;
    }

    /* =========================================
       6. GLOBAL SCROLLBAR (Thanh cuộn Cyber)
       ========================================= */
    ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
    }

    ::-webkit-scrollbar-track {
        background: rgba(5, 5, 5, 0.9);
        border-left: 1px solid rgba(0, 242, 255, 0.1);
    }

    ::-webkit-scrollbar-thumb {
        background: var(--cyber-blue);
        border-radius: 4px;
    }

    ::-webkit-scrollbar-thumb:hover {
        background: #ffffff;
        box-shadow: 0 0 15px rgba(0, 242, 255, 0.8);
    }

    html {
        scrollbar-width: thin;
        scrollbar-color: var(--cyber-blue) rgba(5, 5, 5, 0.9);
    }
    /* Nút Cyberpunk Đỏ (Dành cho chức năng Xóa) */
    .btn-cyber-danger {
        background: rgba(255, 0, 60, 0.15);
        color: #ff003c;
        border-color: #ff003c;
    }

    .btn-cyber-danger:hover {
        box-shadow: 0 0 25px rgba(255, 0, 60, 0.8), inset 0 0 10px rgba(255, 255, 255, 0.2);
    }
    #cusName::placeholder,
    #cusPhone::placeholder,
    #cusAddress::placeholder {
        color: #a0a0a0;
    }
    /* Nút Cyberpunk Xanh Nhạt (Info) - Dành cho nút Chờ Duyệt */
    .btn-cyber-info {
        background: rgba(0, 242, 255, 0.15);
        color: #00f2ff;
        border-color: rgba(0, 242, 255, 0.4);
    }

    .btn-cyber-info:hover {
        background: #00f2ff;
        color: #000;
        box-shadow: 0 0 20px rgba(0, 242, 255, 0.6);
        transform: translateY(-2px); /* Nảy lên một chút cho mượt */
    }
    /* Nút Cyberpunk Vàng/Cam (Warning) - Dành cho nút Chờ Duyệt Nhập Kho */
    .btn-cyber-warning {
        background: rgba(255, 170, 0, 0.15);
        color: #ffaa00;
        border-color: #ffaa00;
        box-shadow: 0 0 10px rgba(255, 170, 0, 0.2);
    }

    .btn-cyber-warning:hover {
        background: #ffaa00;
        color: #000;
        box-shadow: 0 0 20px rgba(255, 170, 0, 0.8);
        transform: translateY(-2px); /* Hiệu ứng nảy lên cho mượt */
    }
    /* ================================================================
   🔥 HỆ THỐNG CẢI TẠO NÚT TOGGLE SIDEBAR STYLE CYBERPUNK
================================================================ */

    /* 1. Định dạng lại nút bấm chính (Xóa nền thô, tạo bo góc) */
    .toggle-sidebar-btn {
        position: fixed; /* Cố định vị trí */
        top: 15px;
        left: 15px;
        z-index: 2000; /* Luôn nằm trên Sidebar */
        background: rgba(10, 15, 20, 0.7); /* Nền tối trong suốt */
        border: 1px solid rgba(0, 242, 255, 0.3); /* Viền Cyan mờ */
        backdrop-filter: blur(10px); /* Làm mờ hậu cảnh */
        padding: 12px;
        border-radius: 10px; /* Bo góc mượt */
        cursor: pointer;
        transition: all 0.3s ease-in-out;
        outline: none !important;
        box-shadow: 0 0 10px rgba(0, 242, 255, 0.1); /* Glow nhẹ ban đầu */
    }

    /* Hiệu ứng Hover: Sáng rực lên */
    .toggle-sidebar-btn:hover {
        border-color: #00f2ff;
        box-shadow: 0 0 20px rgba(0, 242, 255, 0.6);
        background: rgba(10, 15, 20, 0.9);
    }

    /* 2. Tạo hình dạng 3 thanh ngang (Hamburger) */
    .cyber-hamburger {
        width: 26px;
        height: 20px;
        position: relative;
        transform: rotate(0deg);
        transition: .5s ease-in-out;
    }

    .cyber-hamburger span {
        display: block;
        position: absolute;
        height: 3px;
        width: 100%;
        background: #00f2ff; /* Màu Cyan đặc trưng */
        border-radius: 2px;
        opacity: 1;
        left: 0;
        transform: rotate(0deg);
        transition: .25s ease-in-out;
        /* Hiệu ứng đổ bóng Neon */
        box-shadow: 0 0 8px rgba(0, 242, 255, 0.7);
    }

    /* Vị trí ban đầu của 3 thanh */
    .cyber-hamburger span:nth-child(1) { top: 0px; }
    .cyber-hamburger span:nth-child(2) { top: 8px; width: 80%; } /* Thanh giữa ngắn hơn tý cho nghệ */
    .cyber-hamburger span:nth-child(3) { top: 16px; }

    /* 3. 🔥 MAGIC: Hiệu ứng chuyển thể khi Sidebar bị THU GỌN (Collapsed)
       Giả sử hàm JS toggleSidebar() của đại ca sẽ thêm class 'collapsed' vào thẻ <body> hoặc <nav>
       Dưới đây đệ giả sử nó thêm class vào thẻ <nav class="sidebar"> chứa cái nút này.
    */

    /* Khi nav.sidebar có class 'collapsed', 3 thanh biến thành dấu X */
    nav.sidebar.collapsed .cyber-hamburger span:nth-child(1) {
        top: 8px;
        transform: rotate(135deg);
        background: #ffaa00; /* Đổi sang màu Vàng Neon khi đóng */
        box-shadow: 0 0 10px rgba(255, 170, 0, 0.8);
    }

    nav.sidebar.collapsed .cyber-hamburger span:nth-child(2) {
        opacity: 0;
        left: -40px; /* Đẩy thanh giữa sang bên */
    }

    nav.sidebar.collapsed .cyber-hamburger span:nth-child(3) {
        top: 8px;
        transform: rotate(-135deg);
        background: #ffaa00; /* Đổi sang màu Vàng Neon khi đóng */
        box-shadow: 0 0 10px rgba(255, 170, 0, 0.8);
    }
    /* 🌟 Ẩn hoàn toàn logo khối lập phương khi thu nhỏ Sidebar để không bị đè nút X */
    body.sidebar-collapsed .sidebar-logo-icon {
        display: none !important;
    }
    /* 🌟 Hiệu ứng mượt mà: Đợi Sidebar mở bung ra xong mới từ từ hiện chữ */
    .sidebar-logo h5,
    .sidebar .nav-link span,
    .sidebar-heading span {
        white-space: nowrap; /* Chống rớt chữ xuống dòng */
        animation: textDelayReveal 0.45s ease-out forwards;
    }

    /* Kịch bản diễn viên: Tàng hình 70% thời gian đầu, 30% sau mới hiện */
    @keyframes textDelayReveal {
        0% { opacity: 0; }
        70% { opacity: 0; } /* Đợi khoảng 0.3s cho khung Sidebar trượt xong */
        100% { opacity: 1; } /* Sáng dần lên */
    }
    #prodName::placeholder {
        color: rgba(0, 255, 255, 0.5); /* Màu xanh cyan mờ */
        opacity: 1;
    }

    #cusPhone::placeholder {
        color: rgba(0, 255, 255, 0.5);
        opacity: 1;
    }
    #cusAddress::placeholder {
        color: rgba(0, 255, 255, 0.5);
        opacity: 1;
    }
    #cusName::placeholder {
        color: rgba(0, 255, 255, 0.5);
        opacity: 1;
    }
    #supName::placeholder {
        color: rgba(0, 255, 255, 0.5);
        opacity: 1;
    }
    #supPhone::placeholder {
        color: rgba(0, 255, 255, 0.5);
        opacity: 1;
    }
    #supAddress::placeholder {
        color: rgba(0, 255, 255, 0.5);
        opacity: 1;
    }
    #catName::placeholder {
        color: rgba(0, 255, 255, 0.5);
        opacity: 1;
    }
</style>
</file>

