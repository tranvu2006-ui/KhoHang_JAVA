                </span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Cột Phải: Thay Đổi Mật Khẩu -->
      <div class="col-xl-7 col-lg-6">
        <div class="content-card p-4">
          <div class="d-flex align-items-center mb-4 pb-3 border-bottom-cyber">
            <i class="fas fa-shield-alt text-cyber-blue fa-2x me-3"></i>
            <h4 class="m-0 text-cyber-blue font-weight-bold" style="letter-spacing: 1px;">THAY ĐỔI MÃ KHÓA BẢO MẬT</h4>
          </div>

          <form id="passwordForm" onsubmit="handleChangePassword(event)">
            <div class="mb-3">
              <label for="oldPassword" class="cyber-label">Mật Khẩu Hiện Tại</label>
              <input type="password" id="oldPassword" class="form-control cyber-input" required placeholder="••••••••">
            </div>
            
            <div class="mb-3">
              <label for="newPassword" class="cyber-label">Mật Khẩu Mới</label>
              <input type="password" id="newPassword" class="form-control cyber-input" required placeholder="••••••••" oninput="analyzePasswordStrength(this.value)">
              
              <!-- Thang đo độ mạnh mật khẩu -->
              <div class="mt-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <span class="text-muted-cyber" style="font-size: 0.8rem;">Độ mạnh mã khóa:</span>
                  <span id="strength-label" class="badge-cyber badge-strength-none">Chưa Nhập</span>
                </div>
                <div class="strength-bar-container">
                  <div id="strength-bar" class="strength-bar-fill"></div>
                </div>
                <div class="strength-hints mt-2">
                  <small class="text-muted-cyber d-block" id="hint-len"><i class="far fa-circle me-1"></i>Tối thiểu 6 ký tự</small>
                  <small class="text-muted-cyber d-block" id="hint-num"><i class="far fa-circle me-1"></i>Có chữ số (0-9)</small>
                  <small class="text-muted-cyber d-block" id="hint-spec"><i class="far fa-circle me-1"></i>Có ký tự đặc biệt (@, #, $, ...)</small>
                </div>
              </div>
            </div>

            <div class="mb-4">
              <label for="confirmPassword" class="cyber-label">Xác Nhận Mật Khẩu Mới</label>
              <input type="password" id="confirmPassword" class="form-control cyber-input" required placeholder="••••••••">
            </div>

            <div class="text-end">
              <button type="submit" class="cyber-btn w-100 py-3">
                <i class="fas fa-key me-2"></i>CẬP NHẬT MÃ KHÓA MỚI
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- KHỐI CSS TỰ CHỈNH (Được SPA tự động nạp vì nằm bên trong main-content) -->
    <style>
    /* CSS CYBERPUNK SLIM THEME */
