      border: 1px solid rgba(255, 255, 255, 0.2) !important;
      color: rgba(255, 255, 255, 0.6) !important;
    }

    .badge-strength-weak {
      background: rgba(255, 0, 60, 0.15) !important;
      border: 1px solid var(--cyber-red) !important;
      color: var(--cyber-red) !important;
    }

